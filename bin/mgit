#!/usr/bin/env bash
# shellcheck disable=SC2088  # literal '~' in TOML path strings is intentional, not tilde expansion
# shellcheck disable=SC2016  # backticks inside single-quoted generated-comment strings are literal
# Run a command across multiple git repositories.
#
# Terminology: a repository has either a standard structure (a checkout with a
# .git directory) or a nested structure (a .bare store, a .git controller file,
# and a main/ checkout). Container dirs are the directories between the
# cwd and repository roots. The repo set comes from a
# .mgit.toml in the current directory if one exists; otherwise the tree
# is walked for .git entries (dropping any nested under another repo).
#
# A .mgit.toml manifest defines path-keyed repository/workspace
# members directly. Existing schema-1 grouped manifests remain readable. A
# repository-owned .mgit.toml only maps a
# symlink to its target under `symlinks`.
#
# `mgit register` writes a .mgit.toml in every container dir (listing
# its children) and .mgit.toml in each leaf that owns cross-repo symlinks.
# It stops at leaf dirs — it never descends into a repo — and always scans
# fresh, ignoring existing config (so it implies -I).
#
# At runtime mgit walks that hierarchy: container members are recursed into,
# repo members are operated on, and the repo containing each symlink target is
# pulled in too (transitive, with cycle/dup guards). git already tracks the
# symlinks themselves, so they come back on clone; mgit only records them.
#
# '#' comments and blank lines are ignored.

MGIT_MANIFEST=.mgit.toml
MGIT_VERSION=0.18.0

CLEAR=$'\033[0m'
BOLD=$'\033[1m'
YELLOW=$'\033[33m'
if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ]; then
  CLEAR=""
  BOLD=""
  YELLOW=""
fi

usage() {
  cat <<'EOF'
Usage: mgit [options] [command]

Run Git commands across multiple repositories and worktrees.

With no command, list the selected checkouts in the current set. Any command that is
not one of the commands below is passed through to Git in every repository.

Options:
  -P, --physical          when discovering repositories, don't enter symlinked
                          directories (default)
  -L, --follow-symlinks   when discovering repositories, enter symlinked
                          directories too
  -B, --bypass            run COMMAND as a Git subcommand even when mgit owns the name
  -R, --raw               run COMMAND directly instead of as a Git subcommand
      --learn             run a Git command and learn its normal output (as learn)
  -j, --jobs <n>          run up to N checkouts at once (default 8)
  -v, --verbose           run checkouts one at a time, streaming every header and output
      --json              print ordinary-command results as one JSON document
  -I, --ignore            ignore workspace manifests and discover repositories
  -t, --territory <handle> select roots resolved by ki for a territory handle
      --estate            select every root in the registered KI estate
      --principals        select the territory Capitals, in KI's order
      --filter <prefix>   literal case-sensitive basename prefix; repeatable OR
  -W, --all-worktrees     include every active linked worktree
  -h, --help              display help for command
  -V, --version           print the CLI version

Commands:
  register                generate workspace manifests and symlink metadata
  repair                  repair config and clone missing repositories
  doctor                  evaluate local prerequisites and configuration
  diag                    print share-safe diagnostic facts
  sync                    update clean tracking branches across the current set
  chain                   run Git commands in order in each checkout, or a recipe
  overview                show what is outstanding across the current set
  structure               convert repository structure across the current set
  worktree                manage worktrees across the current set
  learn                   learn a Git command's normal output so later runs hide it
  completion              print shell completion setup
  help [command]          display help for a command

Run 'mgit help <command>' for detailed help on a command.
A lone word naming a chain recipe (git config mgit.chain.NAME) runs it as
'mgit chain NAME' unless mgit owns the name; -B, -R and --learn skip recipes.
Global selectors that do not apply to a command cause a usage error.
Discovery options apply only without a workspace manifest or with --ignore.
Short options group (-vW) and take attached values (-j4); a long option's
value may follow an equals sign (--jobs=4).
EOF
}

register_usage() {
  cat <<'EOF'
Usage: mgit register [add|rm] [options]

Generate workspace- and repository-kind .mgit.toml documents for current tree.

The command scans saved locations (default: local), does not descend into
repositories, and refreshes generated members. Repositories found outside the
workspace are recorded as ordinary members with ../ paths.
Add or remove locations and refresh in one command. When Chezmoi manages a
generated manifest, its source state is updated too.

Options:
  -t, --territory <handle> add or remove a territory location (repeatable)
      --repo <path>   add or remove a Git repository location (repeatable)
  -n, --dry-run       preview manifest writes and removals without changing files
  -h, --help  display help for command
EOF
}

repair_usage() {
  cat <<'EOF'
Usage: mgit repair [--dry-run]

Repair recognised configuration and clone missing workspace repositories.
Existing repository paths are never replaced, and external members (../ paths)
are never cloned.

Options:
  -n, --dry-run  preview config repairs and clones without changing files
  -h, --help  display help for command
EOF
}

doctor_usage() {
  printf 'Usage: mgit doctor\nReport environment context and evaluate Git and the current manifest without changing anything.\nPackage updates and repository synchronization are not checked.\n'
}

diag_usage() {
  printf 'Usage: mgit diag [--full]\nPrint tool, installation, platform, runtime and configuration facts.\nLocal paths and configuration error details are omitted unless --full is given.\n'
}

structure_usage() {
  cat <<'EOF'
Usage: mgit structure <standard|nested> [-n|--dry-run]

Convert eligible repositories in the current set between standard and nested
structures. Apply changes by default; use -n or --dry-run to preview them.

Commands:
  nested    convert standard repositories to nested structure
  standard  convert nested repositories to standard structure
EOF
}

worktree_usage() {
  cat <<'EOF'
Usage: mgit worktree <command>

Manage worktrees for every structured repository in the current set.

Commands:
  list                  list worktrees grouped by shared Git store
  status                show branch and cleanliness for every worktree
  add <branch>          add a worktree for an existing local or origin branch
  remove <path>         remove one linked worktree

Run 'mgit help worktree <command>' for detailed help on a worktree command.
EOF
}

worktree_add_usage() {
  cat <<'EOF'
Usage: mgit worktree add <branch>

Add a worktree for BRANCH to every standard or nested repository in the current
set. BRANCH must exist locally or at origin in every affected repository.
EOF
}

worktree_remove_usage() {
  cat <<'EOF'
Usage: mgit worktree remove <path> [-f|--force]

Remove a linked worktree from the repository containing the current directory.
The primary checkout and a nested repository's required main/ checkout cannot
be removed.

Options:
  -f, --force  discard changes in a dirty linked worktree
EOF
}

sync_usage() {
  cat <<'EOF'
Usage: mgit sync [-i|--interactive] [-v|--verbose]

Update clean tracking branches across the current repository set.

Primary checkouts are selected by default; pass -W or --all-worktrees to
include linked worktrees.
Every branch with a remote upstream is fetched first, in parallel, even with
local changes. Then, one checkout at a time, a branch only behind its upstream
is fast-forwarded and a branch only ahead is pushed. Diverged, dirty, detached
and untracked branches, and failed fetches, are named with a warning and left
untouched; nothing is merged or rebased. A diverged branch's warning says
whether merging its upstream would be clean or conflict, computed in memory;
-v lists the conflicting files. Pulls and pushes are named on standard output;
skips, warnings, progress and prompts go to standard error. The run ends with
one tally of every checkout - in sync, pulled, pushed, skipped and failed -
then one indented line per skipped or failed checkout with its reason and
ahead and behind counts, marked (stale) after a failed fetch.

Options:
 -i, --interactive       confirm each pull and push; an empty answer skips
 -v, --verbose           also print progress for every checkout
 -h, --help              display help for this command
EOF
}

overview_usage() {
  cat <<'EOF'
Usage: mgit overview [--json] [-v|--verbose] [--stale-days <days>]

Show what is outstanding across the current repository set, read-only.

Each selected checkout reports its branch and upstream, ahead and behind
counts, staged, modified, untracked and conflicted files, stashes, prunable or
detached worktrees, and obsolete branches: local branches merged into the
default branch, patch-equivalent to it, with a gone upstream or stale, and
remote-tracking branches merged or stale. Branches checked out in a worktree
are never obsolete. Only local Git state is read; nothing is fetched or changed.
Clean checkouts appear only in the closing count unless --verbose is given.
The command exits 1 only when a checkout cannot be read.

Options:
      --json              print one JSON document instead of the terminal view
  -v, --verbose           name clean checkouts too
      --stale-days <days> idle days before an unmerged branch is stale (default 30)
  -h, --help              display help for this command
EOF
}

learn_usage() {
  cat <<'EOF'
Usage: mgit learn <git-command> [argument ...]
       mgit learn --list
       mgit learn --forget <git-command> [argument ...]

Run a Git command across the current set, one repository or more, as usual,
then learn its normal output. Each checkout's own details (path, remote URL,
upstream, remote, branch and repository name) are replaced by placeholders.
When every checkout then prints the same output, or more than half do, mgit
says how many agreed, names any that differed, and asks before writing it as
a template, one file per command after Git alias expansion, in
${XDG_CONFIG_HOME:-~/.config}/mgit/templates/. A run whose input is not a
terminal never asks and writes nothing. When half or fewer agree, mgit names
the checkouts that differed and writes nothing. Later runs of the command
count a checkout that exits 0 with output matching the template as quiet.
With no templates, every checkout with output is shown. 'mgit --learn COMMAND'
is the same as 'mgit learn COMMAND'.

Options:
      --list      list learned templates and their files
      --forget    remove the template for a command
  -h, --help      display help for command
EOF
}

chain_usage() {
  cat <<'EOF'
Usage: mgit chain <git-command> [argument ...] [--then <git-command> [argument ...]] ...
       mgit chain <recipe>

Run Git commands in order in each checkout of the current set.

Every word after 'chain' goes to Git unchanged except a literal --then, which
ends one step and starts the next, wherever it appears; write a path named
--then as ./--then. Each checkout runs its steps in order and stops at its
first failing step; other checkouts carry on. Checkouts run in parallel up to
--jobs, and --verbose runs them one at a time, streaming every step. Each
checkout's block names every step as ok, failed or not run, followed by its
output, and the run ends with one tally: completed, stopped at a later step,
and failed to start, where no step completed. --json prints one document. The
run exits 1 unless every checkout completed.

A recipe is a chain saved in the Git configuration visible where mgit runs:
  git config --global mgit.chain.tidy 'fetch --prune --then pull --ff-only'
'mgit chain tidy' runs it, and so does 'mgit tidy' when no other word follows
and mgit owns no command of that name; -B, -R and --learn skip recipes. A
recipe's value splits into words as a shell would, honouring quotes and
backslashes.

Options:
  -h, --help              display help for this command
EOF
}

completion_usage() {
  cat <<'EOF'
Usage: mgit completion <shell>

Print a completion definition for Bash or Zsh.
EOF
}

# Syntax failures in mgit's own grammar are distinct from Git command failures:
# they always identify the bad input and include the mgit usage text.
usage_error() {
  printf 'mgit: error: %s\n' "$*" >&2
  usage >&2
  return 2
}

usage_error_for() {
  local usage_function="$1"
  shift
  printf 'mgit: error: %s\n' "$*" >&2
  "$usage_function" >&2
  return 2
}

# Expand the option forms the CLI conventions allow into separate words before
# an option loop reads them: short groups (-vW), attached short values (-j2)
# and long values after an equals sign (--jobs=2). Arguments: a mode, the
# letters of short options that take a value, the long options that take a
# value separated by spaces, then the words. Mode top stops at the first
# operand, the command whose words go to Git untouched. A value letter takes
# the rest of its word, or the next word. Anything else passes on unchanged for
# the option loop to accept or refuse. The result is left in split_args.
split_options() {
  local mode="$1" values="$2" long_values=" $3 " word letter rest
  shift 3
  split_args=()
  while [ $# -gt 0 ]; do
    word="$1"; shift
    case "$word" in
      --) split_args+=(--); break ;;
      --*=*)
        case "$long_values" in
          *" ${word%%=*} "*) split_args+=("${word%%=*}" "${word#*=}") ;;
          *) split_args+=("$word") ;;
        esac ;;
      --*)
        split_args+=("$word")
        case "$long_values" in
          *" $word "*) [ $# -eq 0 ] || { split_args+=("$1"); shift; } ;;
        esac ;;
      -?*)
        rest="${word#-}"
        while [ -n "$rest" ]; do
          letter="${rest:0:1}"; rest="${rest:1}"
          split_args+=("-$letter")
          case "$values" in
            *"$letter"*)
              if [ -n "$rest" ]; then split_args+=("$rest")
              elif [ $# -gt 0 ]; then split_args+=("$1"); shift
              fi
              rest="" ;;
          esac
        done ;;
      *)
        split_args+=("$word")
        [ "$mode" != top ] || break ;;
    esac
  done
  [ $# -eq 0 ] || split_args+=("$@")
}

completion_script() {
  case "${1:-}" in
    bash)
      cat <<'EOF'
_mgit() {
  local cur="${COMP_WORDS[COMP_CWORD]}" command="" subcommand="" word
  local i=1 command_index=0
  local -a commands global_options
  commands='register repair doctor diag sync chain overview structure worktree learn completion help'
  global_options='-P --physical -L --follow-symlinks -B --bypass -R --raw -j --jobs -v --verbose --json --learn -I --ignore -t --territory --estate --principals --filter -W --all-worktrees -h --help -V --version'
  case "${COMP_WORDS[COMP_CWORD - 1]:-}" in
    --repo)
      COMPREPLY=( $(compgen -d -- "$cur") )
      return
      ;;
    -t|--territory|-j|--jobs)
      COMPREPLY=()
      return
      ;;
  esac
  while (( i < COMP_CWORD )); do
    word="${COMP_WORDS[i]}"
    case "$word" in
      -t|--territory|--filter|-j|--jobs) ((i += 2)); continue ;;
      -P|--physical|-L|--follow-symlinks|-B|--bypass|-R|--raw|-v|--verbose|--json|--learn|-I|--ignore|--estate|--principals|-W|--all-worktrees|-h|--help|-V|--version) ((i += 1)); continue ;;
      --) ((i += 1)); break ;;
      *) command="$word"; command_index=$i; break ;;
    esac
  done
  if [[ -n "$command" ]]; then
    subcommand="${COMP_WORDS[command_index + 1]:-}"
  fi
  case "$command" in
    register)
      if (( COMP_CWORD == command_index + 1 )); then
        COMPREPLY=( $(compgen -W 'add rm --territory -t --repo --dry-run -n --help -h' -- "$cur") )
      else
        COMPREPLY=( $(compgen -W '--territory -t --repo --dry-run -n --help -h' -- "$cur") )
      fi
      ;;
    repair)
      COMPREPLY=( $(compgen -W '--dry-run -n --help -h' -- "$cur") )
      ;;
    diag)
      COMPREPLY=( $(compgen -W '--full --help -h' -- "$cur") )
      ;;
    doctor)
      COMPREPLY=( $(compgen -W '--help -h' -- "$cur") )
      ;;
    sync)
      COMPREPLY=( $(compgen -W '--interactive -i --verbose -v --help -h' -- "$cur") )
      ;;
    chain)
      if (( COMP_CWORD == command_index + 1 )); then
        COMPREPLY=( $(compgen -W "$(git config --name-only --get-regexp '^mgit\.chain\.' 2>/dev/null | sed 's/^mgit\.chain\.//') --help -h" -- "$cur") )
      else
        COMPREPLY=( $(compgen -W '--then' -- "$cur") )
      fi
      ;;
    overview)
      case "${COMP_WORDS[COMP_CWORD - 1]:-}" in
        --stale-days) COMPREPLY=() ;;
        *) COMPREPLY=( $(compgen -W '--json --verbose -v --stale-days --help -h' -- "$cur") ) ;;
      esac
      ;;
    structure)
      COMPREPLY=( $(compgen -W 'standard nested --dry-run -n --help -h' -- "$cur") )
      ;;
    worktree)
      case "$subcommand" in
        '') COMPREPLY=( $(compgen -W 'list status add remove --help -h' -- "$cur") ) ;;
        list|status) COMPREPLY=( $(compgen -W '--help -h' -- "$cur") ) ;;
        add) COMPREPLY=() ;;
        remove) COMPREPLY=( $(compgen -W '--force -f --help -h' -- "$cur") ) ;;
        *) COMPREPLY=() ;;
      esac
      ;;
    learn)
      COMPREPLY=( $(compgen -W '--list --forget --help -h' -- "$cur") )
      ;;
    completion)
      COMPREPLY=( $(compgen -W 'bash zsh --help -h' -- "$cur") )
      ;;
    help)
      COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
      ;;
    *)
      COMPREPLY=( $(compgen -W "$commands $global_options" -- "$cur") )
      ;;
  esac
}

complete -F _mgit mgit
EOF
      ;;
    zsh)
      cat <<'EOF'
#compdef mgit

_mgit() {
  local context state state_descr line
  local -a global_commands global_options worktree_commands
  typeset -A opt_args
  global_commands=(
    'register:generate workspace manifests and repository symlink metadata'
    'repair:repair config and clone missing repositories'
    'doctor:evaluate local prerequisites and configuration'
    'diag:print share-safe environment facts'
    'sync:update clean tracking branches across the current set'
    'chain:run Git commands in order in each checkout, or a recipe'
    'overview:show what is outstanding across the current set'
    'structure:change repository structure across the current set'
    'worktree:manage standard and nested worktrees'
    'learn:learn the normal output of a Git command'
    'completion:print shell completion setup'
    'help:display help for a command'
  )
  global_options=(
    '-P[when discovering repositories, do not enter symlinked directories]'
    '--physical[when discovering repositories, do not enter symlinked directories]'
    '-L[when discovering repositories, enter symlinked directories too]'
    '--follow-symlinks[when discovering repositories, enter symlinked directories too]'
    '-B[run a Git subcommand even when mgit owns the name]'
    '--bypass[run a Git subcommand even when mgit owns the name]'
    '-R[run an ordinary command without git prefix]'
    '--raw[run an ordinary command without git prefix]'
    '--learn[learn the normal output of a Git command]'
    '-j[run up to N checkouts at once]:jobs:'
    '--jobs[run up to N checkouts at once]:jobs:'
    '-v[run checkouts one at a time, streaming all output]'
    '--verbose[run checkouts one at a time, streaming all output]'
    '--json[print ordinary-command results as one JSON document]'
    '-I[ignore workspace selection from .mgit.toml]'
    '--ignore[ignore workspace selection from .mgit.toml]'
    '-t[select roots resolved by ki for a named territory]:territory name:'
    '--territory[select roots resolved by ki for a named territory]:territory name:'
    '--estate[select every root in the registered KI estate]'
    '--principals[select the territory Capitals in KI order]'
    '--filter[limit the repo set to paths with a directory-basename prefix]:literal prefix:'
    '-W[include linked worktrees for listing, ordinary commands, sync and overview]'
    '--all-worktrees[include linked worktrees for listing, ordinary commands, sync and overview]'
    '-h[show help]'
    '--help[show help]'
    '-V[show version]'
    '--version[show version]'
  )
  worktree_commands=(
    'list:list worktrees'
    'status:show worktree status'
    'add:add a remote branch'
    'remove:remove a worktree'
  )
  case $words[2] in
    register) _arguments -s '1:action:(add rm)' '*--territory[add or remove a territory location]:territory name:' '*-t[add or remove a territory location]:territory name:' '*--repo[add or remove a repository location]:repository path:_files -/' '--dry-run[preview manifest changes]' '-n[preview manifest changes]' '-h[display help for command]' '--help[display help for command]' ;;
    repair) _arguments -s '--dry-run[preview config repairs and clones]' '-n[preview config repairs and clones]' '-h[display help for command]' '--help[display help for command]' ;;
    doctor) _arguments '-h[display help for command]' '--help[display help for command]' ;;
    diag) _arguments '--full[include local directory]' '-h[display help for command]' '--help[display help for command]' ;;
    sync) _arguments -s '-i[confirm each pull and push]' '--interactive[confirm each pull and push]' '-v[print progress for every checkout]' '--verbose[print progress for every checkout]' '-h[display help for command]' '--help[display help for command]' ;;
    chain)
      if (( CURRENT == 3 )); then
        compadd -- -h --help ${${(f)"$(git config --name-only --get-regexp '^mgit\.chain\.' 2>/dev/null)"}#mgit.chain.}
      else
        compadd -- --then
      fi ;;
    overview) _arguments -s '--json[print one JSON document]' '-v[name clean checkouts too]' '--verbose[name clean checkouts too]' '--stale-days[idle days before an unmerged branch is stale]:days:' '-h[display help for command]' '--help[display help for command]' ;;
    structure) _arguments -s '1:repository structure:(standard nested)' '--dry-run[preview changes]' '-n[preview changes]' '-h[display help for command]' '--help[display help for command]' ;;
    worktree)
      case $words[3] in
        '') _describe -t commands 'worktree command' worktree_commands ;;
        list|status) _arguments '-h[display help for command]' '--help[display help for command]' ;;
        add) _arguments '1:remote branch name:' '-h[display help for command]' '--help[display help for command]' ;;
        remove) _arguments -s '1:worktree path:_files -/' '--force[discard dirty changes]' '-f[discard dirty changes]' '-h[display help for command]' '--help[display help for command]' ;;
      esac ;;
    learn) _arguments '--list[list learned templates]' '--forget[remove the template for a command]' '-h[display help for command]' '--help[display help for command]' ;;
    completion) _arguments '1:shell:(bash zsh)' '-h[display help for command]' '--help[display help for command]' ;;
    help) _describe -t commands command global_commands ;;
    *)
      _arguments -s $global_options '1:command:->command'
      case $state in
        command) _describe -t commands command global_commands ;;
      esac ;;
  esac
}

compdef _mgit mgit
EOF
      ;;
    *)
      printf 'mgit completion: expected bash or zsh\n' >&2
      return 2
      ;;
  esac
}

completion_command() {
  local shell_name="" help=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) help=true ;;
      bash|zsh)
        [ -z "$shell_name" ] || { usage_error_for completion_usage "completion: unexpected argument: $1"; return; }
        shell_name="$1" ;;
      *) usage_error_for completion_usage "completion: unexpected argument: $1"; return ;;
    esac
    shift
  done
  [ "$help" = false ] || { completion_usage; return 0; }
  [ -n "$shell_name" ] || { usage_error_for completion_usage 'completion: expected bash or zsh'; return; }
  completion_script "$shell_name"
}

# Trim leading/trailing whitespace.
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Command substitution normally discards trailing newlines in pathnames.
# A sentinel retains those bytes while preserving the called command's status.
captured_path=""
cwd_canon=""
capture_path() {
  captured_path=$("$@" && printf '\001') || return 1
  captured_path=${captured_path%$'\001'}
}

# Canonical physical path without an extra line terminator.
canon_dir() { ( cd -P "$1" 2>/dev/null && printf '%s' "$PWD" ); }

# Assign the physical directory path without command-substitution byte loss.
capture_dir() {
  capture_path canon_dir "$2" || return 1
  printf -v "$1" '%s' "$captured_path"
}

# Resolve $1 (absolute, ~-prefixed, or relative to base dir $2) to an
# absolute-ish path. May still contain .. components.
resolve_path() {
  local p="$1" base="$2"
  case "$p" in
    "~")   p="$HOME" ;;
    "~/"*) p="$HOME/${p#\~/}" ;;
  esac
  case "$p" in
    /*) printf '%s' "$p" ;;
    *)  printf '%s/%s' "$base" "$p" ;;
  esac
}

# Canonical absolute path of any existing path (dir or file/symlink leaf).
canon_any() {
  local p="$1" d b
  if [ -d "$p" ]; then canon_dir "$p"; return; fi
  d=$(dirname "$p"); b=$(basename "$p")
  capture_dir d "$d" || return 1
  [ -z "$d" ] && return 1
  printf '%s/%s' "$d" "$b"
}

# Git-aware repository predicates.  A linked worktree has a .git *file*, so
# filesystem tests alone cannot describe the repository model.  Git owns that
# distinction and also tells us whether a directory is a bare repository.
is_worktree() {
  [ "$(git -C "$1" rev-parse --is-inside-work-tree 2>/dev/null)" = true ]
}

is_bare_repo() {
  [ "$(git -C "$1" rev-parse --is-bare-repository 2>/dev/null)" = true ]
}

is_repo() {
  is_worktree "$1" || is_bare_repo "$1"
}

# A nested repository is deliberately stricter than an arbitrary Git worktree.
# Its outer directory is a controller, .bare is the common Git store, and every
# live checkout (including main) lives directly below that controller.
is_nested_repo() {
  local root="$1" bare path
  capture_dir root "$root" || return 1
  capture_dir bare "$root/.bare" || return 1
  [ -f "$root/.git" ] && [ -d "$bare" ] && [ -d "$root/main" ] || return 1
  is_bare_repo "$root" || return 1
  is_worktree "$root/main" || return 1
  [ "$(git_common_dir "$root/main")" = "$bare" ] || return 1
  while IFS= read -r -d '' path; do
    [ -z "$path" ] && continue
    case "$path" in
      "$bare"|"$root"/*) ;;
      *) return 1 ;;
    esac
  done < <(active_worktree_paths "$root")
}

repo_type() {
  if is_nested_repo "$1"; then
    printf 'nested'
  elif { [ -d "$1/.git" ] || [ -f "$1/.git" ]; } && is_worktree "$1"; then
    printf 'standard'
  elif is_bare_repo "$1"; then
    printf 'bare'
  else
    printf 'unknown'
  fi
}

# Explicit territory roots may be linked checkouts. Local discovery and
# registration keep primary units and expand their worktrees only on request.
is_linked_checkout() {
  local root="$1" common gitdir
  [ -f "$root/.git" ] || return 1
  is_nested_repo "$root" && return 1
  capture_path git_common_dir "$root" || return 1; common="$captured_path"
  capture_path git_dir "$root" || return 1; gitdir="$captured_path"
  [ "$gitdir" != "$common" ]
}

active_worktree_paths() {
  local root="$1" path="" state="" line
  while IFS= read -r -d '' line; do
    if [ -z "$line" ]; then
      [ -n "$path" ] && [ "$state" != prunable ] && [ "$state" != bare ] && printf '%s\0' "$path"
      path=""; state=""
      continue
    fi
    case "$line" in
      "worktree "*) path="${line#worktree }" ;;
      prunable*) state=prunable ;;
      bare) state=bare ;;
    esac
  done < <(git -C "$root" worktree list --porcelain -z 2>/dev/null)
  [ -n "$path" ] && [ "$state" != prunable ] && [ "$state" != bare ] && printf '%s\0' "$path"
  return 0
}

# A repository has two useful identities: its checkout (if any) and the common
# Git directory shared by all of its linked worktrees.  Keep them distinct so
# commands can operate on checkouts while grouping by their shared store.
git_common_dir() {
  local dir="$1" common
  common=$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null) || return 1
  case "$common" in
    /*) canon_dir "$common" ;;
    *)  canon_dir "$dir/$common" ;;
  esac
}

git_dir() {
  local dir="$1" gitdir
  gitdir=$(git -C "$dir" rev-parse --git-dir 2>/dev/null) || return 1
  case "$gitdir" in
    /*) canon_dir "$gitdir" ;;
    *)  canon_dir "$dir/$gitdir" ;;
  esac
}

# Print the canonical directory of the Git repository containing path $1.  Git
# handles .git directories, linked-worktree .git files, and bare repositories.
repo_of() {
  local p="$1" d root
  if [ -d "$p" ]; then d="$p"; else d="${p%/*}"; [ "$d" = "$p" ] && d="."; fi
  capture_dir d "$d" || return 1
  [ -z "$d" ] && return 1
  while :; do
    root=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$root" ]; then canon_dir "$root"; return; fi
    is_bare_repo "$d" && { printf '%s' "$d"; return 0; }
    [ "$d" = "/" ] && return 1
    d="${d%/*}"; [ -z "$d" ] && d="/"
  done
}

# Return the nested structure containing $1, if any. A command issued from a
# child checkout must still resolve to the outer workspace controller.
structure_of() {
  local p="$1" d
  if [ -d "$p" ]; then d="$p"; else d="${p%/*}"; [ "$d" = "$p" ] && d="."; fi
  capture_dir d "$d" || return 1
  while :; do
    is_nested_repo "$d" && { printf '%s' "$d"; return 0; }
    [ "$d" = "/" ] && return 1
    d="${d%/*}"; [ -z "$d" ] && d="/"
  done
}

# Relative path from dir $1 to path $2 (both absolute & canonical).
relpath() {
  local from="${1%/}" to="${2%/}" i j n m min rel="" down=""
  local fa ta IFS=/
  read -r -d '' -a fa < <(printf '%s\0' "${from#/}")
  read -r -d '' -a ta < <(printf '%s\0' "${to#/}")
  unset IFS
  n=${#fa[@]}; m=${#ta[@]}; min=$n; [ "$m" -lt "$n" ] && min=$m
  i=0
  while [ "$i" -lt "$min" ] && [ "${fa[$i]}" = "${ta[$i]}" ]; do i=$((i + 1)); done
  j=$i; while [ "$j" -lt "$n" ]; do rel="../$rel"; j=$((j + 1)); done
  j=$i; while [ "$j" -lt "$m" ]; do down="$down${ta[$j]}/"; j=$((j + 1)); done
  rel="$rel$down"; rel="${rel%/}"
  [ -z "$rel" ] && rel="."
  printf '%s' "$rel"
}

# Pick how to express target $2 in repo $1's .mgit.toml: relative to the repo
# for nearby targets, ~-prefixed or absolute for ones living far out of tree.
choose_target() {
  local repoabs="$1" tabs="$2" rel
  rel=$(relpath "$repoabs" "$tabs")
  case "$rel" in
    ../../*)
      case "$tabs" in
        "$HOME"/*) printf '~/%s' "${tabs#"$HOME"/}" ;;
        *)         printf '%s' "$tabs" ;;
      esac ;;
    *) printf '%s' "$rel" ;;
  esac
}

# Escape a value for a TOML basic string. Generated manifests only use basic
# strings, so parsing does not require an external TOML implementation.
toml_escape() {
  local s="$1"
  case "$s" in
    *$'\n'*|*$'\r'*) return 1 ;;
  esac
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

toml_quote() {
  local escaped
  escaped=$(toml_escape "$1") || return 1
  printf '"%s"' "$escaped"
}

# Read a TOML basic string. The supported escape sequences cover generated
# manifests and allow manually maintained path, source, and target values.
toml_string() {
  local s="$1" result="" ch escape i
  [ "${s#\"}" != "$s" ] && [ "${s%\"}" != "$s" ] || return 1
  s=${s:1:${#s}-2}
  i=0
  while [ "$i" -lt "${#s}" ]; do
    ch=${s:i:1}
    if [ "$ch" = "\\" ]; then
      i=$((i + 1))
      [ "$i" -lt "${#s}" ] || return 1
      escape=${s:i:1}
      case "$escape" in
        '"'|\\) result+="$escape" ;;
        b) result+=$'\b' ;;
        t) result+=$'\t' ;;
        n) result+=$'\n' ;;
        f) result+=$'\f' ;;
        r) result+=$'\r' ;;
        *) return 1 ;;
      esac
    elif [ "$ch" = '"' ]; then
      return 1
    else
      result+="$ch"
    fi
    i=$((i + 1))
  done
  printf '%s' "$result"
}

# Parse a one-line TOML array of basic strings into toml_array_values.
toml_string_array() {
  local value="$1" body ch item i=0 start escaped
  toml_array_values=()
  [ "${value:0:1}" = '[' ] && [ "${value: -1}" = ']' ] || return 1
  body=${value:1:${#value}-2}
  while :; do
    while [ "$i" -lt "${#body}" ]; do
      ch=${body:i:1}
      [ "$ch" = ' ' ] || [ "$ch" = $'\t' ] || break
      i=$((i + 1))
    done
    [ "$i" -lt "${#body}" ] || return 0
    [ "${body:i:1}" = '"' ] || return 1
    start=$i
    i=$((i + 1))
    escaped=false
    while [ "$i" -lt "${#body}" ]; do
      ch=${body:i:1}
      if [ "$escaped" = true ]; then
        escaped=false
      elif [ "$ch" = "\\" ]; then
        escaped=true
      elif [ "$ch" = '"' ]; then
        break
      fi
      i=$((i + 1))
    done
    [ "$i" -lt "${#body}" ] || return 1
    item=$(toml_string "${body:start:i-start+1}") || return 1
    toml_array_values+=("$item")
    i=$((i + 1))
    while [ "$i" -lt "${#body}" ]; do
      ch=${body:i:1}
      [ "$ch" = ' ' ] || [ "$ch" = $'\t' ] || break
      i=$((i + 1))
    done
    [ "$i" -lt "${#body}" ] || return 0
    [ "${body:i:1}" = ',' ] || return 1
    i=$((i + 1))
  done
}

# Strip a TOML comment without treating a # inside a basic string as a comment.
toml_without_comment() {
  local s="$1" result="" ch escaped=false quoted=false i
  i=0
  while [ "$i" -lt "${#s}" ]; do
    ch=${s:i:1}
    if [ "$escaped" = true ]; then
      result+="$ch"
      escaped=false
    elif [ "$quoted" = true ] && [ "$ch" = "\\" ]; then
      result+="$ch"
      escaped=true
    elif [ "$ch" = '"' ]; then
      result+="$ch"
      [ "$quoted" = true ] && quoted=false || quoted=true
    elif [ "$ch" = '#' ] && [ "$quoted" = false ]; then
      break
    else
      result+="$ch"
    fi
    i=$((i + 1))
  done
  printf '%s' "$result"
}

manifest_kind() {
  local file="$1" line key value kind="" seen_kind=false

  [ -f "$file" ] || {
    printf 'mgit: manifest not found: %s\n' "$file" >&2
    return 1
  }

  while IFS= read -r line || [ -n "$line" ]; do
    line=$(toml_without_comment "$line")
    line=$(trim "$line")
    [ -z "$line" ] && continue

    case "$line" in
      \[*\]) break ;;
      *=*)
        key=$(trim "${line%%=*}")
        [ "$key" = kind ] || continue
        [ "$seen_kind" = false ] || {
          printf 'mgit: %s: duplicate kind field\n' "$file" >&2
          return 1
        }
        value=$(trim "${line#*=}")
        kind=$(toml_string "$value") || {
          printf 'mgit: %s: kind must be a TOML basic string\n' "$file" >&2
          return 1
        }
        seen_kind=true
        ;;
    esac
  done < "$file"

  [ "$seen_kind" = true ] || {
    printf 'mgit: %s: missing kind field\n' "$file" >&2
    return 1
  }
  case "$kind" in
    workspace|repository) printf '%s' "$kind" ;;
    *)
      printf 'mgit: %s: unsupported manifest kind: %s\n' "$file" "$kind" >&2
      return 1
      ;;
  esac
}

# Parse repository-kind metadata and emit symlink records.
parse_mgit() {
  local repo="$1" line key value section=""
  local file="${2:-$repo/$MGIT_MANIFEST}"
  local kind="" seen_schema=false seen_kind=false
  local seen_symlinks=() existing

  [ -f "$file" ] || return 0

  while IFS= read -r line || [ -n "$line" ]; do
    line=$(toml_without_comment "$line")
    line=$(trim "$line")
    [ -z "$line" ] && continue

    case "$line" in
      '[symlinks]') section=symlinks ;;
      \[*\])
        printf 'mgit: %s: repository manifest contains unsupported table: %s\n' "$file" "$line" >&2
        return 1
        ;;
      *=*)
        key=$(trim "${line%%=*}")
        value=$(trim "${line#*=}")
        if [ -z "$section" ]; then
          case "$key" in
            schema)
              [ "$seen_schema" = false ] || {
                printf 'mgit: %s: duplicate schema field\n' "$file" >&2
                return 1
              }
              [ "$value" = 1 ] || {
                printf 'mgit: %s: unsupported repository schema: %s\n' "$file" "$value" >&2
                return 1
              }
              seen_schema=true
              ;;
            kind)
              [ "$seen_kind" = false ] || {
                printf 'mgit: %s: duplicate kind field\n' "$file" >&2
                return 1
              }
              kind=$(toml_string "$value") || {
                printf 'mgit: %s: kind must be a TOML basic string\n' "$file" >&2
                return 1
              }
              [ "$kind" = repository ] || {
                printf 'mgit: %s: expected repository kind, found %s\n' "$file" "$kind" >&2
                return 1
              }
              seen_kind=true
              ;;
            *)
              printf 'mgit: %s: unsupported repository field: %s\n' "$file" "$key" >&2
              return 1
              ;;
          esac
        else
          key=$(toml_string "$key") || {
            printf 'mgit: %s: expected TOML basic-string symlink path: %s\n' "$file" "$line" >&2
            return 1
          }
          value=$(toml_string "$value") || {
            printf 'mgit: %s: expected TOML basic-string symlink target: %s\n' "$file" "$line" >&2
            return 1
          }
      if [ -z "$key" ] || [ -z "$value" ]; then
        printf 'mgit: %s: symlink path and target must not be empty\n' "$file" >&2
        return 1
      fi
          for existing in "${seen_symlinks[@]+"${seen_symlinks[@]}"}"; do
            [ "$existing" != "$key" ] || {
              printf 'mgit: %s: duplicate symlink path: %s\n' "$file" "$key" >&2
              return 1
            }
          done
          seen_symlinks+=("$key")
          printf 'L\t%s\t%s\n' "$key" "$value"
        fi
        ;;
      *)
        printf 'mgit: %s: unsupported TOML statement: %s\n' "$file" "$line" >&2
        return 1
        ;;
    esac
  done < "$file"

  if [ "$seen_kind" != true ] || [ "$kind" != repository ]; then
    printf 'mgit: %s: missing kind = "repository"\n' "$file" >&2
    return 1
  fi
}

workspace_default=""
workspace_groups=()
workspace_record_groups=()
workspace_record_kinds=()
workspace_record_paths=()
workspace_record_types=()
workspace_record_sources=()
workspace_record_scopes=()
workspace_legacy_warned=()
workspace_member_group=""
workspace_member_direct=false
workspace_member_kind=""
workspace_member_path=""
workspace_member_type=""
workspace_member_source=""
workspace_member_seen_kind=false
workspace_member_seen_path=false
workspace_member_seen_type=false
workspace_member_seen_source=false

workspace_path_safe() {
  case "$1" in
    ""|/*|~*|.|..|./*|../*|*/./*|*/../*|*/.|*/..|*//*|*/)
      return 1
      ;;
    *$'\n'*|*$'\r'*|*$'\t'*) return 1 ;;
  esac
}

# An external repository member climbs out of the manifest directory with one
# or more leading ../ segments, then names a safe path below that ancestor.
workspace_external_path_safe() {
  local tail="$1"
  case "$tail" in ../*) ;; *) return 1 ;; esac
  while [ "${tail#../}" != "$tail" ]; do tail="${tail#../}"; done
  workspace_path_safe "$tail"
}

workspace_member_scope() {
  case "$1" in ../*) printf external ;; *) printf local ;; esac
}

# An external member that resolves physically back inside its own workspace
# directory would duplicate a local member, so it is rejected, naming the
# local path to declare instead. Both arguments are canonical physical paths.
workspace_external_inside() {
  local workspace="$1" destination="$2" prefix="$3"
  case "$destination" in
    "$workspace"|"$workspace"/*) ;;
    *) return 1 ;;
  esac
  printf '%s: external repository path resolves inside the workspace; declare it as the local member "%s": %s\n' \
    "$prefix" "$(relpath "$workspace" "$destination")" "$destination" >&2
}

location_path_safe() {
  case "$1" in
    ""|/*|~*|.|./*|*/./*|*/.|*//*|*/)
      return 1 ;;
    *$'\n'*|*$'\r'*|*$'\t'*)
      return 1 ;;
  esac
}

legacy_agora_error() {
  printf 'mgit: %s: Agora syntax is retired; back up the manifest, explicitly replace agora:NAME with territory:HANDLE and remove agora fields/member tables in a reviewed copy; preview mgit register --dry-run before refreshing. No state was migrated.\n' "$1" >&2
}

workspace_location_valid() {
  case "$1" in
    agora:*) legacy_agora_error "$MGIT_MANIFEST"; return 1 ;;
    local) return 0 ;;
    territory:?*)
      case "${1#territory:}" in *$'\n'*|*$'\r'*|*$'\t'*) return 1 ;; esac
      return 0 ;;
    repo:?*) location_path_safe "${1#repo:}" ;;
    *) return 1 ;;
  esac
}

workspace_location_known() {
  local needle="$1" item
  for item in "${workspace_locations[@]+"${workspace_locations[@]}"}"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

workspace_group_known() {
  local needle="$1" item
  for item in "${workspace_groups[@]+"${workspace_groups[@]}"}"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

workspace_finish_member() {
  local file="$1" i
  [ -n "$workspace_member_group" ] || return 0
  if [ "$workspace_member_seen_kind" != true ] || [ "$workspace_member_seen_path" != true ]; then
    printf 'mgit: %s: workspace member requires kind and path\n' "$file" >&2
    return 1
  fi
  case "$workspace_member_kind" in
    repository)
      if [ "$workspace_member_group" = default ]; then
        if [ "$workspace_member_seen_type" != true ]; then
          printf 'mgit: %s: default repository member requires type\n' "$file" >&2
          return 1
        fi
        case "$workspace_member_type" in standard|nested|bare) ;; *)
          printf 'mgit: %s: unsupported repository type: %s\n' "$file" "$workspace_member_type" >&2
          return 1
        esac
      elif [ "$workspace_member_seen_type" = true ] || [ "$workspace_member_seen_source" = true ]; then
        printf 'mgit: %s: non-default groups must not contain type or source\n' "$file" >&2
        return 1
      fi
      ;;
    workspace)
      if [ "$workspace_member_seen_type" = true ] || [ "$workspace_member_seen_source" = true ]; then
        printf 'mgit: %s: workspace members may only contain kind and path\n' "$file" >&2
        return 1
      fi
      ;;
    *)
      printf 'mgit: %s: unsupported member kind: %s\n' "$file" "$workspace_member_kind" >&2
      return 1
      ;;
  esac
  if ! workspace_path_safe "$workspace_member_path"; then
    if [ "$workspace_member_direct" != true ] || [ "$workspace_member_kind" != repository ] ||
       ! workspace_external_path_safe "$workspace_member_path"; then
      printf 'mgit: %s: unsafe workspace member path: %s\n' "$file" "$workspace_member_path" >&2
      return 1
    fi
  fi
  for i in "${!workspace_record_paths[@]}"; do
    if [ "${workspace_record_groups[$i]}" = "$workspace_member_group" ] &&
       [ "${workspace_record_scopes[$i]}" != legacy ] &&
       [ "${workspace_record_paths[$i]}" = "$workspace_member_path" ]; then
      printf 'mgit: %s: duplicate member path in group %s: %s\n' \
        "$file" "$workspace_member_group" "$workspace_member_path" >&2
      return 1
    fi
  done
  workspace_record_groups+=("$workspace_member_group")
  workspace_record_kinds+=("$workspace_member_kind")
  workspace_record_paths+=("$workspace_member_path")
  workspace_record_types+=("$workspace_member_type")
  workspace_record_sources+=("$workspace_member_source")
  workspace_record_scopes+=("$(workspace_member_scope "$workspace_member_path")")
  workspace_member_group=""
}

workspace_sort_members() {
  local i j group kind path type source scope previous_group previous_path
  for ((i = 1; i < ${#workspace_record_paths[@]}; i += 1)); do
    group="${workspace_record_groups[$i]}"
    kind="${workspace_record_kinds[$i]}"
    path="${workspace_record_paths[$i]}"
    type="${workspace_record_types[$i]}"
    source="${workspace_record_sources[$i]}"
    scope="${workspace_record_scopes[$i]}"
    j=$i
    while [ "$j" -gt 0 ]; do
      previous_group="${workspace_record_groups[$((j - 1))]}"
      previous_path="${workspace_record_paths[$((j - 1))]}"
      { [ "$previous_group" = "$group" ] && [[ "$previous_path" > "$path" ]]; } || [[ "$previous_group" > "$group" ]] || break
      workspace_record_groups[j]="$previous_group"
      workspace_record_kinds[j]="${workspace_record_kinds[j - 1]}"
      workspace_record_paths[j]="$previous_path"
      workspace_record_types[j]="${workspace_record_types[j - 1]}"
      workspace_record_sources[j]="${workspace_record_sources[j - 1]}"
      workspace_record_scopes[j]="${workspace_record_scopes[j - 1]}"
      j=$((j - 1))
    done
    workspace_record_groups[j]="$group"
    workspace_record_kinds[j]="$kind"
    workspace_record_paths[j]="$path"
    workspace_record_types[j]="$type"
    workspace_record_sources[j]="$source"
    workspace_record_scopes[j]="$scope"
  done
}

# Legacy [registered.members."PATH"] tables predate typed external members.
# They stay selectable, warn once per manifest, and are rewritten by register.
# The physical path keys the warning, so each spelling of one file warns once.
workspace_warn_legacy() {
  local file="$1" key item
  key=$(canon_any "$file") || key="$file"
  for item in "${workspace_legacy_warned[@]+"${workspace_legacy_warned[@]}"}"; do
    [ "$item" != "$key" ] || return 0
  done
  workspace_legacy_warned+=("$key")
  printf 'mgit: %s: [registered.members] tables are deprecated; run mgit register to rewrite them as members\n' "$file" >&2
}

# Parse the deliberately small workspace map formats into global record
# arrays. Unsupported or duplicate syntax is rejected instead of being partially
# interpreted.
# shellcheck disable=SC2094 # Parser output is held in globals, not stdout.
parse_workspace() {
  local file="$1" line key value group kind=""
  local seen_schema=false seen_kind=false seen_default=false seen_locations=false
  local direct_members=false legacy_groups=false
  local in_location_member=false snapshot_source="" i
  workspace_default=""
  workspace_locations=()
  workspace_groups=()
  workspace_record_groups=()
  workspace_record_kinds=()
  workspace_record_paths=()
  workspace_record_types=()
  workspace_record_sources=()
  workspace_record_scopes=()
  workspace_member_group=""
  [ -f "$file" ] || { printf 'mgit: workspace manifest not found: %s\n' "$file" >&2; return 1; }

  while IFS= read -r line || [ -n "$line" ]; do
    line=$(toml_without_comment "$line")
    line=$(trim "$line")
    [ -z "$line" ] && continue
    case "$line" in
      agora\ =*|agora=*|\[agora.*) legacy_agora_error "$file"; return 1 ;;
    esac
    if [[ "$line" =~ ^\[(registered)\.members\.(\".*\")\]$ ]]; then
      workspace_finish_member "$file" || return 1
      [ -z "$snapshot_source" ] || [ "$snapshot_source" = "${BASH_REMATCH[1]}" ] || {
        printf 'mgit: %s: mixed registered member table styles\n' "$file" >&2
        return 1
      }
      snapshot_source="${BASH_REMATCH[1]}"
      value=$(toml_string "${BASH_REMATCH[2]}") || return 1
      location_path_safe "$value" || {
        printf 'mgit: %s: unsafe registered member path: %s\n' "$file" "$value" >&2
        return 1
      }
      for i in "${!workspace_record_paths[@]}"; do
        [ "${workspace_record_scopes[$i]}" != legacy ] || [ "${workspace_record_paths[$i]}" != "$value" ] || {
          printf 'mgit: %s: duplicate registered member path: %s\n' "$file" "$value" >&2
          return 1
        }
      done
      workspace_group_known default || workspace_groups+=(default)
      workspace_record_groups+=(default)
      workspace_record_kinds+=(repository)
      workspace_record_paths+=("$value")
      workspace_record_types+=("")
      workspace_record_sources+=("")
      workspace_record_scopes+=(legacy)
      in_location_member=true
      continue
    fi
    if [ "$line" = '[members]' ]; then
      workspace_finish_member "$file" || return 1
      in_location_member=false
      direct_members=true
      workspace_group_known default || workspace_groups+=(default)
      continue
    fi
    if [[ "$line" =~ ^\[members\.(\".*\")\]$ ]]; then
      workspace_finish_member "$file" || return 1
      in_location_member=false
      direct_members=true
      value=$(toml_string "${BASH_REMATCH[1]}") || {
        printf 'mgit: %s: invalid workspace member path: %s\n' "$file" "$line" >&2
        return 1
      }
      workspace_group_known default || workspace_groups+=(default)
      workspace_member_group=default
      workspace_member_direct=true
      workspace_member_kind=""
      workspace_member_path="$value"
      workspace_member_type=""
      workspace_member_source=""
      workspace_member_seen_kind=false
      workspace_member_seen_path=true
      workspace_member_seen_type=false
      workspace_member_seen_source=false
      continue
    fi
    if [[ "$line" =~ ^\[groups\.([A-Za-z0-9_-]+)\]$ ]]; then
      workspace_finish_member "$file" || return 1
      in_location_member=false
      legacy_groups=true
      group="${BASH_REMATCH[1]}"
      workspace_group_known "$group" || workspace_groups+=("$group")
      continue
    fi
    if [[ "$line" =~ ^\[groups\.([A-Za-z0-9_-]+)\.members\]$ ]]; then
      workspace_finish_member "$file" || return 1
      in_location_member=false
      legacy_groups=true
      group="${BASH_REMATCH[1]}"
      workspace_group_known "$group" || workspace_groups+=("$group")
      continue
    fi
    if [[ "$line" =~ ^\[groups\.([A-Za-z0-9_-]+)\.members\.(\".*\")\]$ ]]; then
      workspace_finish_member "$file" || return 1
      in_location_member=false
      legacy_groups=true
      group="${BASH_REMATCH[1]}"
      value=$(toml_string "${BASH_REMATCH[2]}") || {
        printf 'mgit: %s: invalid workspace member path: %s\n' "$file" "$line" >&2
        return 1
      }
      workspace_group_known "$group" || workspace_groups+=("$group")
      workspace_member_group="$group"
      workspace_member_direct=false
      workspace_member_kind=""
      workspace_member_path="$value"
      workspace_member_type=""
      workspace_member_source=""
      workspace_member_seen_kind=false
      workspace_member_seen_path=true
      workspace_member_seen_type=false
      workspace_member_seen_source=false
      continue
    fi
    case "$line" in
      \[*)
        printf 'mgit: %s: unsupported TOML table: %s\n' "$file" "$line" >&2
        return 1
        ;;
      *=*)
        key=$(trim "${line%%=*}")
        value=$(trim "${line#*=}")
        [ "$in_location_member" = false ] || {
          printf 'mgit: %s: registered member tables must be empty\n' "$file" >&2
          return 1
        }
        if [ -z "$workspace_member_group" ]; then
          case "$key" in
            kind)
              [ "$seen_kind" = false ] || {
                printf 'mgit: %s: duplicate kind field\n' "$file" >&2
                return 1
              }
              kind=$(toml_string "$value") || {
                printf 'mgit: %s: kind must be a TOML basic string\n' "$file" >&2
                return 1
              }
              [ "$kind" = workspace ] || {
                printf 'mgit: %s: expected workspace kind, found %s\n' "$file" "$kind" >&2
                return 1
              }
              seen_kind=true
              ;;
            schema)
              [ "$seen_schema" = false ] || {
                printf 'mgit: %s: duplicate schema field\n' "$file" >&2
                return 1
              }
              [ "$value" = 1 ] || {
                printf 'mgit: %s: unsupported workspace schema: %s\n' "$file" "$value" >&2
                return 1
              }
              seen_schema=true
              ;;
            default)
              [ "$seen_default" = false ] || {
                printf 'mgit: %s: duplicate default field\n' "$file" >&2
                return 1
              }
              workspace_default=$(toml_string "$value") || {
                printf 'mgit: %s: default must be a TOML basic string\n' "$file" >&2
                return 1
              }
              case "$workspace_default" in
                ""|*[!A-Za-z0-9_-]*)
                  printf 'mgit: %s: invalid default group: %s\n' "$file" "$workspace_default" >&2
                  return 1
                  ;;
              esac
              seen_default=true
              ;;
            agora)
              legacy_agora_error "$file"; return 1
              ;;
            locations)
              [ "$seen_locations" = false ] || { printf 'mgit: %s: duplicate locations field\n' "$file" >&2; return 1; }
              toml_string_array "$value" || { printf 'mgit: %s: locations must be an array of strings\n' "$file" >&2; return 1; }
              for i in "${toml_array_values[@]+"${toml_array_values[@]}"}"; do
                workspace_location_valid "$i" || { printf 'mgit: %s: invalid location: %s\n' "$file" "$i" >&2; return 1; }
                workspace_location_known "$i" && { printf 'mgit: %s: duplicate location: %s\n' "$file" "$i" >&2; return 1; }
                workspace_locations+=("$i")
              done
              seen_locations=true
              ;;
            *)
              printf 'mgit: %s: unsupported workspace field: %s\n' "$file" "$key" >&2
              return 1
              ;;
          esac
        else
          value=$(toml_string "$value") || {
            printf 'mgit: %s: member field must be a TOML basic string: %s\n' "$file" "$line" >&2
            return 1
          }
          case "$key" in
            kind)
              [ "$workspace_member_seen_kind" = false ] || {
                printf 'mgit: %s: duplicate member kind\n' "$file" >&2
                return 1
              }
              workspace_member_kind="$value"; workspace_member_seen_kind=true
              ;;
            type)
              [ "$workspace_member_seen_type" = false ] || {
                printf 'mgit: %s: duplicate member type\n' "$file" >&2
                return 1
              }
              workspace_member_type="$value"; workspace_member_seen_type=true
              ;;
            source)
              [ "$workspace_member_seen_source" = false ] || {
                printf 'mgit: %s: duplicate member source\n' "$file" >&2
                return 1
              }
              workspace_member_source="$value"; workspace_member_seen_source=true
              ;;
            *)
              printf 'mgit: %s: unsupported member field: %s\n' "$file" "$key" >&2
              return 1
              ;;
          esac
        fi
        ;;
      *)
        printf 'mgit: %s: unsupported TOML statement: %s\n' "$file" "$line" >&2
        return 1
        ;;
    esac
  done < "$file"
  workspace_finish_member "$file" || return 1
  if [ "$seen_locations" = false ]; then workspace_locations=(local); fi
  workspace_location_known local || { printf 'mgit: %s: locations must include local\n' "$file" >&2; return 1; }
  if [ "$snapshot_source" = registered ]; then
    [ "$seen_locations" = true ] || { printf 'mgit: %s: registered members require locations\n' "$file" >&2; return 1; }
    workspace_warn_legacy "$file"
  fi
  workspace_sort_members
  if [ "$seen_kind" != true ] || [ "$kind" != workspace ]; then
    printf 'mgit: %s: missing kind = "workspace"\n' "$file" >&2
    return 1
  fi
  if [ "$seen_schema" = true ]; then
    [ "$direct_members" = false ] || { printf 'mgit: %s: mixed workspace member formats\n' "$file" >&2; return 1; }
    [ "$seen_default" = true ] || { printf 'mgit: %s: missing default group\n' "$file" >&2; return 1; }
    workspace_group_known default || { printf 'mgit: %s: missing structural default group\n' "$file" >&2; return 1; }
    workspace_group_known "$workspace_default" || {
      printf 'mgit: %s: selected default group does not exist: %s\n' "$file" "$workspace_default" >&2
      return 1
    }
  else
    if [ "$legacy_groups" != false ] || [ "$seen_default" != false ] || [ "$direct_members" != true ]; then
      printf 'mgit: %s: unversioned workspace requires direct members and no groups\n' "$file" >&2
      return 1
    fi
    workspace_default=default
  fi
}

config_repair_render() {
  local file="$1" kind="$2" line cleaned
  while IFS= read -r line || [ -n "$line" ]; do
    cleaned=$(trim "$(toml_without_comment "$line")")
    [[ "$cleaned" =~ ^schema[[:space:]]*= ]] && continue
    if [ "$kind" = workspace ]; then
      [[ "$cleaned" =~ ^default[[:space:]]*= ]] && continue
      case "$cleaned" in
        '[groups.default]'|'[groups.default.members]') continue ;;
        '[groups.default.members.'*) line="${line/groups.default.members./members.}" ;;
      esac
    fi
    printf '%s\n' "$line"
  done < "$file"
}

config_repair_command() {
  local dry_run="$1" file="./$MGIT_MANIFEST" kind line cleaned seen_schema=false before after temporary code
  if [ ! -f "$file" ] || [ -L "$file" ]; then
    printf 'mgit repair: regular %s required\n' "$file" >&2
    return 1
  fi
  kind=$(manifest_kind "$file") || return 1
  if [ "$kind" = workspace ]; then
    parse_workspace "$file" || return 1
    if [ "$workspace_default" != default ] || [ "${#workspace_groups[@]}" -ne 1 ]; then
      printf 'mgit repair: alternative groups need a deliberate manual decision: %s\n' "$file" >&2
      return 1
    fi
  else
    parse_mgit . >/dev/null || return 1
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    cleaned=$(trim "$(toml_without_comment "$line")")
    if [[ "$cleaned" =~ ^schema[[:space:]]*= ]]; then seen_schema=true; break; fi
  done < "$file"
  [ "$seen_schema" = true ] || { printf 'mgit repair: already unversioned: %s\n' "$file"; return 0; }
  before=$(git hash-object -- "$file") || return 1
  git diff --no-index -- "$file" <(config_repair_render "$file" "$kind")
  code=$?
  [ "$code" -eq 1 ] || { [ "$code" -eq 0 ] && printf 'mgit repair: no change\n'; return "$code"; }
  [ "$dry_run" = false ] || { printf 'mgit repair: would write %s\n' "$file"; return 0; }
  temporary=$(mktemp "${file}.repair.XXXXXX") || return 1
  if ! cp -p "$file" "$temporary" || ! config_repair_render "$file" "$kind" > "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  if [ "$kind" = workspace ]; then
    parse_workspace "$temporary" || { rm -f -- "$temporary"; return 1; }
  else
    parse_mgit . "$temporary" >/dev/null || { rm -f -- "$temporary"; return 1; }
  fi
  after=$(git hash-object -- "$file") || { rm -f -- "$temporary"; return 1; }
  if [ "$before" != "$after" ] || [ ! -f "$file" ] || [ -L "$file" ]; then
    printf 'mgit repair: manifest changed during repair; retry the preview\n' >&2
    rm -f -- "$temporary"
    return 1
  fi
  mv -- "$temporary" "$file" || { rm -f -- "$temporary"; return 1; }
  printf 'mgit repair: updated %s\n' "$file"
}

write_locations() {
  local location separator=""
  printf 'locations = ['
  for location in "${workspace_locations[@]}"; do
    printf '%s' "$separator"
    toml_quote "$location" || return 1
    separator=', '
  done
  printf ']\n'
}

help_command() {
  local command="${1:-}" subcommand="${2:-}"
  case "$command" in
    '') usage ;;
    register) [ $# -eq 1 ] || { usage_error_for register_usage "help register: unexpected argument: $subcommand"; return; }; register_usage ;;
    repair) [ $# -eq 1 ] || { usage_error_for repair_usage "help repair: unexpected argument: $subcommand"; return; }; repair_usage ;;
    doctor) [ $# -eq 1 ] || { usage_error "help doctor: unexpected argument: $subcommand"; return; }; doctor_usage ;;
    diag) [ $# -eq 1 ] || { usage_error "help diag: unexpected argument: $subcommand"; return; }; diag_usage ;;
    sync) [ $# -eq 1 ] || { usage_error_for sync_usage "help sync: unexpected argument: $subcommand"; return; }; sync_usage ;;
    overview) [ $# -eq 1 ] || { usage_error_for overview_usage "help overview: unexpected argument: $subcommand"; return; }; overview_usage ;;
    chain) [ $# -eq 1 ] || { usage_error_for chain_usage "help chain: unexpected argument: $subcommand"; return; }; chain_usage ;;
    completion) [ $# -eq 1 ] || { usage_error_for completion_usage "help completion: unexpected argument: $subcommand"; return; }; completion_usage ;;
    learn) [ $# -eq 1 ] || { usage_error_for learn_usage "help learn: unexpected argument: $subcommand"; return; }; learn_usage ;;
    structure)
      case $# in
        1) structure_usage ;;
        2) case "$subcommand" in standard|nested) structure_usage ;; *) usage_error_for structure_usage "help structure: unknown command: $subcommand" ;; esac ;;
        *) usage_error_for structure_usage "help structure: unexpected argument: ${3:-}" ;;
      esac ;;
    worktree)
      case $# in
        1) worktree_usage ;;
        2) case "$subcommand" in list|status) worktree_usage ;; add) worktree_add_usage ;; remove) worktree_remove_usage ;; *) usage_error_for worktree_usage "help worktree: unknown command: $subcommand" ;; esac ;;
        *) usage_error_for worktree_usage "help worktree: unexpected argument: ${3:-}" ;;
      esac ;;
    *) usage_error "help: unknown mgit command: $command"; return ;;
  esac
}

# Expand a ~ prefix; leave absolute/relative paths untouched.
expand_tilde() {
  case "$1" in
    "~")   printf '%s' "$HOME" ;;
    "~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
    *)     printf '%s' "$1" ;;
  esac
}

# When chezmoi is configured, let it map generated manifests back into its
# source state. This keeps chezmoi's naming, permissions, and source layout
# authoritative instead of trying to reproduce them here. Synchronization is
# best-effort: a manifest remains generated locally when chezmoi declines it.
# Only paths inside chezmoi's target directory participate; its source
# directory itself is deliberately excluded to avoid managing it recursively.
chezmoi_enabled=false
chezmoi_source_dir=""
chezmoi_target_dir=""
chezmoi_init() {
  local source target
  command -v chezmoi >/dev/null 2>&1 || return 0
  source=$(chezmoi source-path 2>/dev/null) || return 0
  target=$(chezmoi target-path 2>/dev/null) || return 0
  capture_dir source "$source" || return 0
  capture_dir target "$target" || return 0
  [ -n "$source" ] && [ -n "$target" ] || return 0
  chezmoi_source_dir="$source"
  chezmoi_target_dir="$target"
  chezmoi_enabled=true
}

chezmoi_target_file() {
  local path="$1" parent canonical
  [ "$chezmoi_enabled" = true ] || return 1
  parent=$(canon_dir "$(dirname "$path")") || return 1
  canonical="$parent/$(basename "$path")"
  case "$canonical" in
    "$chezmoi_source_dir"/*) return 1 ;;
    "$chezmoi_target_dir"/*) printf '%s' "$canonical" ;;
    *) return 1 ;;
  esac
}

chezmoi_add_manifest() {
  local path="$1" target
  target=$(chezmoi_target_file "$path") || return 0
  if ! chezmoi add "$target"; then
    printf 'mgit register: warning: manifest remains local; chezmoi could not add it: %s\n' "$target" >&2
    return 0
  fi
  printf 'mgit register: added to chezmoi: %s\n' "$target"
}

chezmoi_forget_manifest() {
  local path="$1" target
  target=$(chezmoi_target_file "$path") || return 0
  # source-path succeeds only for an entry chezmoi already manages; an
  # unmanaged local manifest has nothing to remove from the source state.
  chezmoi source-path "$target" >/dev/null 2>&1 || return 0
  if ! chezmoi forget --force "$target"; then
    printf 'mgit register: warning: manifest removal remains local; chezmoi could not forget it: %s\n' "$target" >&2
    return 0
  fi
  printf 'mgit register: removed from chezmoi: %s\n' "$target"
}

# register, repo case: scan dir $1 for symlinks into *other* git repos and write
# its .mgit.toml (symlink entries only). Removes a stale config if none
# are found.
#
# Heavy directories that never hold intentional cross-repo links (.git itself,
# node_modules) are pruned from the scan. Symlinks resolving back inside this
# repo — the overwhelming majority, e.g. node_modules/.bin/* — are skipped with
# a cheap string check, so the expensive repo lookup only runs for the few links
# that actually escape the repo.
register_repo() {
  local dir="$1" repoabs sl slabs tabs trepo i
  local found_links=() found_targets=()
  capture_dir repoabs "$dir" || return 0
  [ -z "$repoabs" ] && return 0
  while IFS= read -r sl; do
    sl="${sl#./}"
    [ -z "$sl" ] && continue
    git -C "$dir" check-ignore -q "$sl" 2>/dev/null && continue  # gitignored = ephemeral, skip
    slabs="$dir/$sl"
    tabs=$(canon_any "$slabs") || continue
    [ -z "$tabs" ] && continue
    case "$tabs" in "$repoabs"/*) continue ;; esac  # internal link: skip cheaply
    trepo=$(repo_of "$tabs")
    [ -z "$trepo" ] && continue                     # target not in a git repo
    found_links+=("$sl")
    found_targets+=("$(choose_target "$repoabs" "$tabs")")
  done < <(cd "$dir" && find . \( -name .git -o -name node_modules \) -prune \
             -o -type l -print 2>/dev/null | sort)

  if [ ${#found_links[@]} -eq 0 ]; then
    if [ -f "$dir/$MGIT_MANIFEST" ]; then
      if [ "$register_dry_run" = true ]; then
        printf 'mgit register: would remove %s\n' "$dir/$MGIT_MANIFEST"
        return 0
      fi
      chezmoi_forget_manifest "$dir/$MGIT_MANIFEST" || return 2
      rm -f "$dir/$MGIT_MANIFEST" || return 2
    fi
    return 0
  fi
  if [ "$register_dry_run" = true ]; then
    printf 'mgit register: would write %s (%d symlink(s))\n' "$dir/$MGIT_MANIFEST" "${#found_links[@]}"
    return 0
  fi
  {
    printf '# Generated by `mgit register`.\n'
    printf 'kind = "repository"\n'
    printf '\n[symlinks]\n'
    for i in "${!found_links[@]}"; do
      toml_quote "${found_links[$i]}" || return 2
      printf ' = '
      toml_quote "${found_targets[$i]}" || return 2
      printf '\n'
    done
  } > "$dir/$MGIT_MANIFEST" || return 2
  chezmoi_add_manifest "$dir/$MGIT_MANIFEST" || return 2
  printf '%s%s%s%s: recorded %d symlink(s)\n' "$BOLD" "$YELLOW" "$dir" "$CLEAR" "${#found_links[@]}"
  return 0
}

# register, recursive: physically scan in postorder, writing a workspace
# manifest in every non-Git container and leaf symlink metadata in repositories.
# Returns 0 if $1 is or contains a repo (so its parent should reference it), 1
# otherwise.
reg_seen=()
reg_is_seen() {
  local needle="$1" x
  for x in "${reg_seen[@]+"${reg_seen[@]}"}"; do
    [ "$x" = "$needle" ] && return 0
  done
  return 1
}

register_repo_preflight() {
  local dir="$1" repoabs sl slabs tabs trepo target
  capture_dir repoabs "$dir" || return 1
  while IFS= read -r sl; do
    sl="${sl#./}"
    [ -z "$sl" ] && continue
    git -C "$dir" check-ignore -q "$sl" 2>/dev/null && continue
    slabs="$dir/$sl"
    tabs=$(canon_any "$slabs") || continue
    case "$tabs" in "$repoabs"/*) continue ;; esac
    trepo=$(repo_of "$tabs")
    [ -n "$trepo" ] || continue
    target=$(choose_target "$repoabs" "$tabs")
    toml_escape "$sl" >/dev/null || {
      printf 'mgit register: symlink path cannot be represented in TOML: %s\n' "$sl" >&2
      return 1
    }
    toml_escape "$target" >/dev/null || {
      printf 'mgit register: symlink target cannot be represented in TOML: %s\n' "$target" >&2
      return 1
    }
  done < <(cd "$dir" && find . \( -name .git -o -name node_modules \) -prune \
             -o -type l -print 2>/dev/null | sort)
}

register_manifest_preflight() {
  local dir="$1" expected="$2"
  local canonical="$dir/$MGIT_MANIFEST"
  local kind

  if [ -f "$canonical" ]; then
    kind=$(manifest_kind "$canonical") || return 1
    [ "$kind" = "$expected" ] || {
      printf 'mgit register: %s has kind %s but directory requires %s\n' \
        "$canonical" "$kind" "$expected" >&2
      return 1
    }
  fi
}

register_location_dirs=()
register_location_values=()
register_snapshot_dirs=()
register_snapshot_paths=()
register_snapshot_roots=()
register_snapshot_types=()
register_snapshot_sources=()
register_discovered=()
register_change_specs=()
register_action=refresh
register_dry_run=false

# Record one location root as a typed repository member of workspace $1,
# keyed by its path relative to the workspace's physical directory $2.
register_snapshot_add() {
  local dir="$1" canonical="$2" root="$3" relative type source i
  capture_dir root "$root" || return 1
  relative=$(relpath "$canonical" "$root")
  if { ! workspace_path_safe "$relative" && ! workspace_external_path_safe "$relative"; } ||
     ! toml_escape "$relative" >/dev/null; then
    printf 'mgit register: repository path cannot be represented: %s\n' "$root" >&2
    return 1
  fi
  for i in "${!register_snapshot_dirs[@]}"; do
    [ "${register_snapshot_dirs[$i]}" != "$dir" ] || [ "${register_snapshot_roots[$i]}" != "$root" ] || return 0
  done
  type=$(repo_type "$root")
  [ "$type" != unknown ] || {
    printf 'mgit register: location is not a repository: %s\n' "$root" >&2
    return 1
  }
  source=$(git -C "$root" remote get-url origin 2>/dev/null || true)
  [ -z "$source" ] || toml_escape "$source" >/dev/null || {
    printf 'mgit register: repository source cannot be represented in TOML: %s\n' "$source" >&2
    return 1
  }
  register_snapshot_dirs+=("$dir")
  register_snapshot_paths+=("$relative")
  register_snapshot_roots+=("$root")
  register_snapshot_types+=("$type")
  register_snapshot_sources+=("$source")
}

register_prepare_locations() {
  local dir="$1" canonical location root actual spec
  local kept=()
  capture_dir canonical "$dir" || return 1
  if [ "$dir" = . ]; then
    for spec in "${register_change_specs[@]+"${register_change_specs[@]}"}"; do
      if [ "$register_action" = add ]; then
        workspace_location_known "$spec" || workspace_locations+=("$spec")
      else
        kept=()
        for location in "${workspace_locations[@]}"; do
          [ "$location" = "$spec" ] || kept+=("$location")
        done
        workspace_locations=("${kept[@]+"${kept[@]}"}")
      fi
    done
  fi
  for location in "${workspace_locations[@]}"; do
    if ! workspace_location_valid "$location" || ! toml_escape "$location" >/dev/null; then
      printf 'mgit register: invalid location: %s\n' "$location" >&2
      return 1
    fi
    register_location_dirs+=("$dir")
    register_location_values+=("$location")
    case "$location" in
      local) ;;
      territory:*)
        select_ki_roots "${location#territory:}" --territory || return 1
        for root in "${selected_repo_dirs[@]}"; do
          register_snapshot_add "$dir" "$canonical" "$root" || return 1
        done
        ;;
      repo:*)
        root=$(resolve_path "${location#repo:}" "$canonical")
        if [ ! -d "$root" ] || [ -L "$root" ]; then
          printf 'mgit register: missing or unsafe repository location: %s\n' "$root" >&2
          return 1
        fi
        capture_dir root "$root" || return 1
        actual=$(repo_type "$root")
        [ "$actual" != unknown ] || {
          printf 'mgit register: location is not a repository: %s\n' "$root" >&2
          return 1
        }
        register_snapshot_add "$dir" "$canonical" "$root" || return 1
        ;;
    esac
  done
}

register_repo_spec() {
  local argument="$1" action="$2" base candidate root relative actual
  base=$(canon_dir .) || return 1
  candidate=$(resolve_path "$argument" "$base")
  if [ -L "$candidate" ] && [ "$action" = add ]; then
    printf 'mgit register: repository location is a symlink: %s\n' "$argument" >&2
    return 1
  fi
  if [ -d "$candidate" ] && [ ! -L "$candidate" ]; then
    capture_dir root "$candidate" || return 1
    if [ "$action" = add ]; then
      actual=$(repo_type "$root")
      [ "$actual" != unknown ] || { printf 'mgit register: not a repository: %s\n' "$argument" >&2; return 1; }
    fi
    relative=$(relpath "$base" "$root")
  elif [ "$action" = rm ]; then
    case "$argument" in
      /*) relative=$(relpath "$base" "$argument") ;;
      *) relative="$argument" ;;
    esac
  else
    printf 'mgit register: missing repository: %s\n' "$argument" >&2
    return 1
  fi
  location_path_safe "$relative" || { printf 'mgit register: invalid repository path: %s\n' "$argument" >&2; return 1; }
  printf 'repo:%s' "$relative"
}

register_preflight_tree() {
  local dir="$1" child kind source
  kind=$(repo_type "$dir")
  if [ "$kind" != unknown ]; then
    if [ "$kind" = standard ]; then
      register_manifest_preflight "$dir" repository || return 1
      [ ! -f "$dir/$MGIT_MANIFEST" ] || parse_mgit "$dir" >/dev/null || return 1
      register_repo_preflight "$dir"
    fi
    return $?
  fi
  register_manifest_preflight "$dir" workspace || return 1
  if [ -f "$dir/$MGIT_MANIFEST" ]; then
    parse_workspace "$dir/$MGIT_MANIFEST" || return 1
    if [ "$workspace_default" != default ] || [ "${#workspace_groups[@]}" -ne 1 ]; then
      printf 'mgit register: remove alternative groups before migrating %s\n' "$dir/$MGIT_MANIFEST" >&2
      return 1
    fi
  else
    workspace_locations=(local)
  fi
  register_prepare_locations "$dir" || return 1
  for child in "$dir"/*/; do
    [ -d "$child" ] || continue
    child="${child%/}"
    [ -L "$child" ] && continue
    is_linked_checkout "$child" && continue
    kind=$(repo_type "$child")
    if [ "$kind" != unknown ]; then
      source=$(git -C "$child" remote get-url origin 2>/dev/null || true)
      toml_escape "$(basename "$child")" >/dev/null || return 1
      [ -z "$source" ] || toml_escape "$source" >/dev/null || {
        printf 'mgit register: repository source cannot be represented in TOML: %s\n' "$source" >&2
        return 1
      }
    fi
    register_preflight_tree "$child" || return 1
  done
}

register_tree() {
  local dir="$1" child kid_kinds=() kid_types=() kid_paths=() kid_sources=()
  local kind child_kind source status i j root local_count external_count kept
  local previous_external=()
  kind=$(repo_type "$dir")
  if [ "$kind" != unknown ]; then
    # A nested structure and a bare store are leaf repository units. A standard
    # checkout alone may own cross-repository symlinks to record.
    if [ "$kind" = standard ]; then
      register_repo "$dir" || return 2
    fi
    return 0
  fi
  for child in "$dir"/*/; do
    [ -d "$child" ] || continue          # no subdirs (glob didn't match)
    child="${child%/}"
    [ -L "$child" ] && continue
    is_linked_checkout "$child" && continue
    child_kind=$(repo_type "$child")
    if [ "$child_kind" != unknown ]; then
      register_tree "$child"
      status=$?
      [ "$status" -eq 0 ] || return "$status"
      capture_dir root "$child" && register_discovered+=("$root")
      source=$(git -C "$child" remote get-url origin 2>/dev/null || true)
      kid_kinds+=(repository)
      kid_types+=("$child_kind")
      kid_paths+=("$(basename "$child")")
      kid_sources+=("$source")
    else
      register_tree "$child"
      status=$?
      if [ "$status" -eq 0 ]; then
        kid_kinds+=(workspace)
        kid_types+=("")
        kid_paths+=("$(basename "$child")")
        kid_sources+=("")
      elif [ "$status" -ne 1 ]; then
        return "$status"
      fi
    fi
  done
  if [ -f "$dir/$MGIT_MANIFEST" ]; then
    parse_workspace "$dir/$MGIT_MANIFEST" || return 2
    for i in "${!workspace_record_paths[@]}"; do
      [ "${workspace_record_scopes[$i]}" = external ] || continue
      previous_external+=("${workspace_record_paths[$i]}")
    done
  fi
  workspace_locations=()
  for i in "${!register_location_dirs[@]}"; do
    [ "${register_location_dirs[$i]}" = "$dir" ] || continue
    workspace_locations+=("${register_location_values[$i]}")
  done
  # Location roots become ordinary repository members after the local ones.
  # A root inside this workspace that local discovery already recorded, here or
  # in a child workspace, is not written again.
  local_count=${#kid_types[@]}
  for i in "${!register_snapshot_dirs[@]}"; do
    [ "${register_snapshot_dirs[$i]}" = "$dir" ] || continue
    case "${register_snapshot_paths[$i]}" in
      ../*) ;;
      *) selected_path_seen "${register_snapshot_roots[$i]}" "${register_discovered[@]+"${register_discovered[@]}"}" && continue ;;
    esac
    kid_kinds+=(repository)
    kid_types+=("${register_snapshot_types[$i]}")
    kid_paths+=("${register_snapshot_paths[$i]}")
    kid_sources+=("${register_snapshot_sources[$i]}")
  done
  external_count=$((${#kid_types[@]} - local_count))
  # Registration regenerates external members from saved locations, so name
  # any hand-written one that no location produces before it disappears.
  for i in "${!previous_external[@]}"; do
    kept=false
    for j in "${!kid_paths[@]}"; do
      [ "${kid_paths[$j]}" != "${previous_external[$i]}" ] || kept=true
    done
    [ "$kept" = false ] || continue
    if [ "$register_dry_run" = true ]; then
      printf 'mgit register: %s: would drop external member without a saved location: %s (keep it with mgit register add --repo %s)\n' \
        "$dir/$MGIT_MANIFEST" "${previous_external[$i]}" "${previous_external[$i]}"
    else
      printf 'mgit register: %s: dropped external member without a saved location: %s (restore it with mgit register add --repo %s)\n' \
        "$dir/$MGIT_MANIFEST" "${previous_external[$i]}" "${previous_external[$i]}" >&2
    fi
  done
  if [ ${#kid_types[@]} -gt 0 ]; then
    if [ "$register_dry_run" = true ]; then
      printf 'mgit register: would write %s (%d local and %d external member(s))\n' \
        "$dir/$MGIT_MANIFEST" "$local_count" "$external_count"
      return 0
    fi
    {
      printf '# Generated by `mgit register`.\n'
      printf 'kind = "workspace"\n'
      write_locations || return 2
      for i in "${!kid_types[@]}"; do
        printf '\n[members.'
        toml_quote "${kid_paths[$i]}" || return 2
        printf ']\nkind = '
        toml_quote "${kid_kinds[$i]}" || return 2
        if [ "${kid_kinds[$i]}" = repository ]; then
          printf '\ntype = '
          toml_quote "${kid_types[$i]}" || return 2
        fi
        if [ "${kid_kinds[$i]}" = repository ] && [ -n "${kid_sources[$i]}" ]; then
          printf '\nsource = '
          toml_quote "${kid_sources[$i]}" || return 2
        fi
        printf '\n'
      done
    } > "$dir/$MGIT_MANIFEST" || return 2
    chezmoi_add_manifest "$dir/$MGIT_MANIFEST" || return 2
    if [ "$external_count" -gt 0 ]; then
      printf '%s%s%s%s: recorded %d local and %d external member(s)\n' \
        "$BOLD" "$YELLOW" "$dir" "$CLEAR" "$local_count" "$external_count"
    else
      printf '%s%s%s%s: recorded %d member(s)\n' "$BOLD" "$YELLOW" "$dir" "$CLEAR" "${#kid_types[@]}"
    fi
    return 0
  fi
  if [ -f "$dir/$MGIT_MANIFEST" ]; then
    if [ "$register_dry_run" = true ]; then
      printf 'mgit register: would remove %s\n' "$dir/$MGIT_MANIFEST"
      return 1
    fi
    chezmoi_forget_manifest "$dir/$MGIT_MANIFEST" || return 2
    rm -f "$dir/$MGIT_MANIFEST" || return 2
  fi
  return 1
}

# Repair is deliberately workspace-driven: it never discovers arbitrary
# repositories, never replaces an existing path and never clones an external
# member outside the workspace. Structural default-group
# repository entries carry the type and optional source emitted by register.
repair_seen=()
repair_dry_run=false
repair_preflight_workspaces=()
repair_preflight_repositories=()
repair_seen_dir() {
  local needle="$1" item
  for item in "${repair_seen[@]+"${repair_seen[@]}"}"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

repair_preflight_seen() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

repair_preflight() {
  local base="$1" canonical destination actual i identity scope
  local groups=() kinds=() paths=() types=() sources=() scopes=()
  capture_dir canonical "$base" || {
    printf 'mgit repair: cannot read workspace directory: %s\n' "$base" >&2
    return 1
  }
  repair_preflight_seen "$canonical" \
    "${repair_preflight_workspaces[@]+"${repair_preflight_workspaces[@]}"}" && {
    printf 'mgit repair: duplicate or cyclic workspace path: %s\n' "$canonical" >&2
    return 1
  }
  repair_preflight_workspaces+=("$canonical")
  parse_workspace "$canonical/$MGIT_MANIFEST" || return 1
  groups=("${workspace_record_groups[@]+"${workspace_record_groups[@]}"}")
  kinds=("${workspace_record_kinds[@]+"${workspace_record_kinds[@]}"}")
  paths=("${workspace_record_paths[@]+"${workspace_record_paths[@]}"}")
  types=("${workspace_record_types[@]+"${workspace_record_types[@]}"}")
  sources=("${workspace_record_sources[@]+"${workspace_record_sources[@]}"}")
  scopes=("${workspace_record_scopes[@]+"${workspace_record_scopes[@]}"}")
  for i in "${!paths[@]}"; do
    [ "${groups[$i]}" = default ] || continue
    scope="${scopes[$i]}"
    [ "$scope" != legacy ] || continue
    destination=$(resolve_path "${paths[$i]}" "$canonical")
    case "${kinds[$i]}" in
      workspace)
        if [ ! -d "$destination" ] || [ -L "$destination" ]; then
          printf 'mgit repair: workspace member is missing or unsafe: %s\n' "$destination" >&2
          return 1
        fi
        [ -f "$destination/$MGIT_MANIFEST" ] || {
          printf 'mgit repair: workspace manifest is missing: %s\n' "$destination/$MGIT_MANIFEST" >&2
          return 1
        }
        repair_preflight "$destination" || return 1
        ;;
      repository)
        identity="$destination"
        if [ -e "$destination" ] || [ -L "$destination" ]; then
          [ ! -L "$destination" ] || {
            printf 'mgit repair: refusing repository symlink: %s\n' "$destination" >&2
            return 1
          }
          actual=$(repo_type "$destination")
          [ "$actual" != unknown ] || {
            printf 'mgit repair: refusing to replace non-repository path: %s\n' "$destination" >&2
            return 1
          }
          [ "${types[$i]}" = "$actual" ] || {
            printf 'mgit repair: structure mismatch at %s (manifest: %s, found: %s)\n' \
              "$destination" "${types[$i]}" "$actual" >&2
            return 1
          }
          capture_dir identity "$destination" || return 1
          if [ "$scope" = external ] &&
            workspace_external_inside "$canonical" "$identity" 'mgit repair'; then
            return 1
          fi
        elif [ "$scope" = external ]; then
          continue
        elif [ -z "${sources[$i]}" ]; then
          printf 'mgit repair: no clone URL for missing member: %s\n' "$destination" >&2
          return 1
        fi
        # An external repository may be shared by several workspaces.
        [ "$scope" = local ] || continue
        repair_preflight_seen "$identity" \
          "${repair_preflight_repositories[@]+"${repair_preflight_repositories[@]}"}" && {
          printf 'mgit repair: duplicate repository path: %s\n' "$identity" >&2
          return 1
        }
        repair_preflight_repositories+=("$identity")
        ;;
    esac
  done
}

repair_clone() {
  local kind="$1" destination="$2" source="$3" parent branch
  parent=$(dirname "$destination")
  mkdir -p "$parent" || return 1
  case "$kind" in
    S)
      git clone "$source" "$destination" || return 1
      ;;
    B)
      git clone --bare "$source" "$destination" || return 1
      ;;
    N)
      mkdir "$destination" || return 1
      if ! git clone --bare "$source" "$destination/.bare" || \
         ! printf 'gitdir: ./.bare\n' > "$destination/.git"; then
        printf 'mgit repair: nested clone failed; retained partial destination: %s\n' "$destination" >&2
        return 1
      fi
      branch=$(git --git-dir="$destination/.bare" symbolic-ref --quiet --short HEAD) || {
        printf 'mgit repair: cannot determine the default branch for %s\n' "$source" >&2
        return 1
      }
      if ! git --git-dir="$destination/.bare" worktree add "$destination/main" "$branch"; then
        printf 'mgit repair: nested checkout failed; retained partial destination: %s\n' "$destination" >&2
        return 1
      fi
      ;;
  esac
  printf 'mgit repair: cloned %s\n' "$destination"
}

repair_tree() {
  local base="$1" canonical kind member source destination actual failed=false i scope
  local groups=() kinds=() paths=() types=() sources=() scopes=()
  capture_dir canonical "$base" || {
    printf 'mgit repair: cannot read workspace directory: %s\n' "$base" >&2
    return 1
  }
  repair_seen_dir "$canonical" && {
    printf 'mgit repair: duplicate or cyclic workspace path: %s\n' "$canonical" >&2
    return 1
  }
  repair_seen+=("$canonical")
  parse_workspace "$canonical/$MGIT_MANIFEST" || return 1
  groups=("${workspace_record_groups[@]+"${workspace_record_groups[@]}"}")
  kinds=("${workspace_record_kinds[@]+"${workspace_record_kinds[@]}"}")
  paths=("${workspace_record_paths[@]+"${workspace_record_paths[@]}"}")
  types=("${workspace_record_types[@]+"${workspace_record_types[@]}"}")
  sources=("${workspace_record_sources[@]+"${workspace_record_sources[@]}"}")
  scopes=("${workspace_record_scopes[@]+"${workspace_record_scopes[@]}"}")

  for i in "${!paths[@]}"; do
    [ "${groups[$i]}" = default ] || continue
    scope="${scopes[$i]}"
    # Legacy registered entries carry no type or source; they select only.
    [ "$scope" != legacy ] || continue
    kind="${kinds[$i]}"
    member="${paths[$i]}"
    source="${sources[$i]}"
    destination=$(resolve_path "$member" "$canonical")
    case "$kind" in
      workspace)
        if [ ! -d "$destination" ] || [ -L "$destination" ]; then
          printf 'mgit repair: workspace member is missing or unsafe: %s\n' "$destination" >&2
          failed=true
        elif [ ! -f "$destination/$MGIT_MANIFEST" ]; then
          printf 'mgit repair: workspace manifest is missing: %s\n' "$destination/$MGIT_MANIFEST" >&2
          failed=true
        else
          repair_tree "$destination" || failed=true
        fi
        ;;
      repository)
        if [ -e "$destination" ] || [ -L "$destination" ]; then
          if [ -L "$destination" ]; then
            printf 'mgit repair: refusing repository symlink: %s\n' "$destination" >&2
            failed=true
            continue
          fi
          actual=$(repo_type "$destination")
          if [ "$actual" = unknown ]; then
            printf 'mgit repair: refusing to replace non-repository path: %s\n' "$destination" >&2
            failed=true
            continue
          fi
          if [ "${types[$i]}" != "$actual" ]; then
            printf 'mgit repair: structure mismatch at %s (manifest: %s, found: %s)\n' \
              "$destination" "${types[$i]}" "$actual" >&2
            failed=true
            continue
          fi
          printf 'mgit repair: present %s\n' "$destination"
        else
          # External repositories belong to another tree; repair never clones them.
          if [ "$scope" = external ]; then
            printf 'mgit repair: not cloning missing external member: %s\n' "$destination"
            continue
          fi
          if [ -z "$source" ]; then
            printf 'mgit repair: no clone URL for missing member: %s\n' "$destination" >&2
            failed=true
            continue
          fi
          case "${types[$i]}" in
            standard) kind=S ;;
            nested) kind=N ;;
            bare) kind=B ;;
          esac
          if [ "$repair_dry_run" = true ]; then
            printf 'mgit repair: would clone %s repository from %s to %s\n' \
              "${types[$i]}" "$source" "$destination"
            continue
          fi
          repair_clone "$kind" "$destination" "$(expand_tilde "$source")" || {
            failed=true
            continue
          }
        fi
        ;;
    esac
  done
  [ "$failed" = false ]
}

repair_command() {
  local help=false kind
  repair_dry_run=false
  split_options sub n '' "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) repair_dry_run=true ;;
      -h|--help) help=true ;;
      *) usage_error_for repair_usage "repair: unexpected argument: $1"; return ;;
    esac
    shift
  done
  [ "$help" = false ] || { repair_usage; return 0; }
  [ -f "./$MGIT_MANIFEST" ] || {
    printf 'mgit repair: no %s workspace manifest in %s\n' "$MGIT_MANIFEST" "$(pwd)" >&2
    return 1
  }
  kind=$(manifest_kind "./$MGIT_MANIFEST") || return 1
  if [ "$kind" = workspace ]; then
    repair_preflight_workspaces=()
    repair_preflight_repositories=()
    repair_preflight "." || return 1
  fi
  config_repair_command "$repair_dry_run" || return 1
  if [ "$kind" = workspace ]; then
    repair_seen=()
    repair_tree "."
  fi
}

diagnostic_context() {
  local path="${BASH_SOURCE[0]}" target parent count=0
  diagnostic_executable=unknown
  diagnostic_installation=unknown
  while [ -L "$path" ] && [ "$count" -lt 40 ]; do
    target=$(readlink "$path") || break
    case "$target" in
      /*) path="$target" ;;
      *) path="$(dirname "$path")/$target" ;;
    esac
    count=$((count + 1))
  done
  if [ -f "$path" ] && [ ! -L "$path" ]; then
    parent=$(cd "$(dirname "$path")" && pwd -P) || parent=""
    if [ -n "$parent" ]; then
      diagnostic_executable="$parent/$(basename "$path")"
      if [ "$(basename "$parent")" = bin ] && [ "$(basename "$path")" = mgit ]; then
        if [ -e "$parent/../.git" ] && [ -f "$parent/../tests/mgit.bats" ]; then
          diagnostic_installation=local
        elif [ -f "$parent/../INSTALL_RECEIPT.json" ]; then
          diagnostic_installation=release
        fi
      fi
    fi
  fi
  diagnostic_platform=$(uname -s 2>/dev/null) || diagnostic_platform=unknown
  diagnostic_architecture=$(uname -m 2>/dev/null) || diagnostic_architecture=unknown
  case "$diagnostic_platform" in
    Darwin|darwin) diagnostic_platform=macos ;;
    Linux) diagnostic_platform=linux ;;
    Windows|win32|MINGW*|MSYS*) diagnostic_platform=windows ;;
  esac
  case "$diagnostic_architecture" in
    x64|AMD64|amd64) diagnostic_architecture=x86_64 ;;
    aarch64) diagnostic_architecture=arm64 ;;
  esac
  diagnostic_configuration=absent
  diagnostic_issue=""
  diagnostic_kind=""
  if [ -e "./$MGIT_MANIFEST" ] || [ -L "./$MGIT_MANIFEST" ]; then
    diagnostic_configuration=invalid
    if [ ! -f "./$MGIT_MANIFEST" ] || [ -L "./$MGIT_MANIFEST" ]; then
      diagnostic_issue='manifest must be a regular file'
    else
      diagnostic_kind=$(manifest_kind "./$MGIT_MANIFEST" 2>/dev/null) || diagnostic_kind=""
      if [ "$diagnostic_kind" = workspace ]; then
        if diagnostic_issue=$(parse_workspace "./$MGIT_MANIFEST" 2>&1 >/dev/null); then
          diagnostic_configuration=valid
        fi
      elif [ "$diagnostic_kind" = repository ]; then
        if diagnostic_issue=$(parse_mgit . 2>&1 >/dev/null); then
          diagnostic_configuration=valid
        fi
      else
        diagnostic_issue=$(manifest_kind "./$MGIT_MANIFEST" 2>&1 >/dev/null)
      fi
    fi
  fi
  # Parser errors may echo configuration values. Even --full exposes only
  # the error category, never a rejected value or an entire source line.
  diagnostic_issue="${diagnostic_issue#"mgit: ./$MGIT_MANIFEST: "}"
  diagnostic_issue="${diagnostic_issue%%:*}"
  case "$diagnostic_issue" in
    'expected repository kind, found '*) diagnostic_issue='expected repository kind' ;;
    'expected workspace kind, found '*) diagnostic_issue='expected workspace kind' ;;
  esac
}

print_diagnostic_context() {
  printf 'Tool: mgit\nVersion: %s\nInstallation: %s\nPlatform: %s\nArchitecture: %s\nRuntime: bash %s\nConfiguration: %s\n' \
    "$MGIT_VERSION" "$diagnostic_installation" "$diagnostic_platform" "$diagnostic_architecture" "${BASH_VERSION%%(*}" "$diagnostic_configuration"
}

doctor_command() {
  local help=false pass=0 warn=0 fail=0
  split_options sub '' '' "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) help=true ;;
      *) usage_error "doctor: unexpected argument: $1"; return ;;
    esac
    shift
  done
  [ "$help" = false ] || { doctor_usage; return 0; }
  diagnostic_context
  print_diagnostic_context
  printf 'Scope: Git availability and current manifest validity (read-only)\nNot checked: package updates and repository synchronization\n'
  if ! command -v git >/dev/null 2>&1; then
    printf 'fail git: Git unavailable; install Git and retry.\n'
    fail=$((fail + 1))
  else
    printf 'pass git: Git available\n'
    pass=$((pass + 1))
  fi
  case "$diagnostic_configuration" in
    absent)
      printf 'pass configuration: no manifest; filesystem discovery available\n'
      pass=$((pass + 1)) ;;
    valid)
      if [ -n "$diagnostic_issue" ]; then
        printf 'warn configuration: %s manifest uses deprecated [registered.members]; preview mgit register --dry-run, then run mgit register.\n' "$diagnostic_kind"
        warn=$((warn + 1))
      else
        printf 'pass configuration: %s manifest valid\n' "$diagnostic_kind"
        pass=$((pass + 1))
      fi ;;
    invalid)
      printf 'fail configuration: correct .mgit.toml; run mgit diag --full for error details.\n'
      fail=$((fail + 1)) ;;
  esac
  printf 'Checks: pass=%s warn=%s fail=%s skipped=0\n' "$pass" "$warn" "$fail"
  if [ "$fail" -gt 0 ]; then
    printf 'Verdict: unhealthy\n'
    return 1
  fi
  printf 'Verdict: healthy\n'
}

diag_command() {
  local full=false help=false
  split_options sub '' '' "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --full) [ "$full" = false ] || { usage_error 'diag: repeated --full'; return; }; full=true ;;
      -h|--help) help=true ;;
      *) usage_error "diag: unexpected argument: $1"; return ;;
    esac
    shift
  done
  [ "$help" = false ] || { diag_usage; return 0; }
  diagnostic_context
  print_diagnostic_context
  if command -v git >/dev/null 2>&1; then
    printf 'mgit diag: git=available\n'
  else
    printf 'mgit diag: git=unavailable\n'
  fi
  if [ -e "./$MGIT_MANIFEST" ] || [ -L "./$MGIT_MANIFEST" ]; then
    printf 'mgit diag: manifest=present\n'
  else
    printf 'mgit diag: manifest=absent\n'
  fi
  if [ "$full" = true ]; then
    printf 'mgit diag: executable=%s\nmgit diag: directory=%s\nmgit diag: configuration-path=%s/%s\n' "$diagnostic_executable" "$(pwd)" "$(pwd)" "$MGIT_MANIFEST"
    [ -z "$diagnostic_issue" ] || printf 'mgit diag: detail=%s\n' "$diagnostic_issue"
  fi
}

worktree_paths=()
worktree_commons=()
worktree_heads=()
worktree_branches=()
worktree_states=()
worktree_seen_commons=()

worktree_common_seen() {
  local needle="$1" item
  for item in "${worktree_seen_commons[@]+"${worktree_seen_commons[@]}"}"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

worktree_add_record() {
  worktree_paths+=("$1")
  worktree_commons+=("$2")
  worktree_heads+=("$3")
  worktree_branches+=("$4")
  worktree_states+=("$5")
}

# Populate records for every worktree attached to the supplied repositories.
# The common directory is deliberately de-duplicated: each linked checkout can
# be discovered independently, but represents the same Git repository.
collect_worktrees() {
  local source common source_type line key value path head branch state
  worktree_paths=()
  worktree_commons=()
  worktree_heads=()
  worktree_branches=()
  worktree_states=()
  worktree_seen_commons=()

  for source in "$@"; do
    common=$(git_common_dir "$source") || continue
    worktree_common_seen "$common" && continue
    worktree_seen_commons+=("$common")
    source_type=$(repo_type "$source")
    path=""; head=""; branch=""; state=""
    while IFS= read -r line || [ -n "$line" ]; do
      if [ -z "$line" ]; then
        if [ -n "$path" ] && { [ "$source_type" != nested ] || [ "$path" != "$common" ]; }; then
          worktree_add_record "$path" "$common" "$head" "$branch" "${state:-normal}"
        fi
        path=""; head=""; branch=""; state=""
        continue
      fi
      key=${line%% *}
      value=${line#* }
      case "$key" in
        worktree) path="$value" ;;
        HEAD)     head="$value" ;;
        branch)   branch="${value#refs/heads/}" ;;
        detached) state="${state:+$state,}detached" ;;
        bare)     state="${state:+$state,}bare" ;;
        prunable) state="${state:+$state,}prunable" ;;
        locked)   state="${state:+$state,}locked" ;;
      esac
    done < <(git -C "$source" worktree list --porcelain 2>/dev/null)
    if [ -n "$path" ] && { [ "$source_type" != nested ] || [ "$path" != "$common" ]; }; then
      worktree_add_record "$path" "$common" "$head" "$branch" "${state:-normal}"
    fi
  done
}

display_worktree_path() {
  local path="$1" canonical
  capture_dir canonical "$path"
  if [ -n "$canonical" ]; then
    disp "$canonical"
  elif [ "${path#/}" != "$path" ]; then
    # `git worktree list` retains an absolute record for a missing checkout;
    # it is still safe to make that lexical path relative to the current tree.
    relpath "$cwd_canon" "$path"
  else
    printf '%s' "$path"
  fi
}

worktree_list() {
  local i previous_common="" common
  collect_worktrees "${repo_units[@]+"${repo_units[@]}"}"
  for i in "${!worktree_paths[@]}"; do
    common="${worktree_commons[$i]}"
    if [ "$common" != "$previous_common" ]; then
      printf 'common-dir: %s\n' "$common"
      previous_common="$common"
    fi
    printf '  %s\t%s\t%s\n' "$(display_worktree_path "${worktree_paths[$i]}")" \
      "${worktree_branches[$i]:-(detached)}" "${worktree_states[$i]}"
  done
}

worktree_status() {
  local i path state status
  collect_worktrees "${repo_units[@]+"${repo_units[@]}"}"
  for i in "${!worktree_paths[@]}"; do
    path="${worktree_paths[$i]}"
    state="${worktree_states[$i]}"
    if [ ! -d "$path" ]; then
      printf '%s\t%s\tmissing (%s)\n' "$(display_worktree_path "$path")" \
        "${worktree_branches[$i]:-(detached)}" "$state"
      continue
    fi
    case "$state" in
      *bare*)
        printf '%s\t%s\tbare store\n' "$(display_worktree_path "$path")" \
          "${worktree_branches[$i]:-(detached)}"
        continue ;;
    esac
    status=$(git -C "$path" status --porcelain 2>/dev/null)
    if [ -n "$status" ]; then state="dirty"; else state="clean"; fi
    printf '%s\t%s\t%s\n' "$(display_worktree_path "$path")" \
      "${worktree_branches[$i]:-(detached)}" "$state"
  done
}

standard_root_of() {
  local source="$1" path common gitdir
  common=$(git_common_dir "$source") || return 1
  while IFS= read -r -d '' path; do
    [ -n "$path" ] || continue
    gitdir=$(git_dir "$path") || continue
    [ "$gitdir" = "$common" ] && { canon_dir "$path"; return 0; }
  done < <(active_worktree_paths "$source")
  return 1
}

worktree_source_repo() {
  local source
  source=$(structure_of ".") || source=$(standard_root_of ".") || source=$(repo_of ".") || {
    printf 'mgit worktree: run this command from inside a Git repository\n' >&2
    return 1
  }
  printf '%s' "$source"
}

valid_worktree_name() {
  case "$1" in
    ""|.|..|*/*|*\\*|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

worktree_default_path() {
  local source="$1" name="$2"
  case "$(repo_type "$source")" in
    nested) printf '%s/%s' "$source" "$name" ;;
    standard) printf '%s/.git/mgit-worktrees/%s' "$source" "$name" ;;
    *) return 1 ;;
  esac
}

worktree_add() {
  local branch="" unit root kind destination count=0 failed=false help=false
  split_options sub '' '' "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) help=true ;;
      -*) usage_error_for worktree_add_usage "worktree add: unknown option: $1"; return ;;
      *)
        [ -z "$branch" ] || { usage_error_for worktree_add_usage "worktree add: unexpected argument: $1"; return; }
        branch="$1" ;;
    esac
    shift
  done
  [ "$help" = false ] || { worktree_add_usage; return 0; }
  [ -n "$branch" ] || { usage_error_for worktree_add_usage 'worktree add: BRANCH is required'; return; }
  valid_worktree_name "${branch//\//-}" || {
    usage_error_for worktree_add_usage "worktree add: invalid branch name: $branch"
    return
  }

  # Preflight every structured repository before creating any worktree. This
  # avoids a typo or an already-checked-out branch leaving a partial set.
  for unit in "${repo_units[@]+"${repo_units[@]}"}"; do
    capture_dir root "$unit" || continue
    kind=$(repo_type "$root")
    case "$kind" in standard|nested) ;; *) continue ;; esac
    count=$((count + 1))
    destination=$(worktree_default_path "$root" "${branch//\//-}") || continue
    [ ! -e "$destination" ] || {
      printf 'mgit worktree add: destination already exists: %s\n' "$destination" >&2
      failed=true
    }
    git -C "$root" show-ref --verify --quiet "refs/heads/$branch" || \
      git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$branch" || {
        printf 'mgit worktree add: branch not found locally or at origin: %s (%s)\n' "$branch" "$root" >&2
        failed=true
      }
  done
  [ "$count" -gt 0 ] || { printf 'mgit worktree add: no standard or nested repositories in the current set\n' >&2; return 1; }
  [ "$failed" = false ] || return 1

  for unit in "${repo_units[@]+"${repo_units[@]}"}"; do
    capture_dir root "$unit" || continue
    kind=$(repo_type "$root")
    case "$kind" in standard|nested) ;; *) continue ;; esac
    destination=$(worktree_default_path "$root" "${branch//\//-}") || continue
    if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$root" worktree add "$destination" "$branch" || return
    else
      git -C "$root" worktree add --track -b "$branch" "$destination" "origin/$branch" || return
    fi
    printf 'mgit: added %s at %s\n' "$branch" "$destination"
  done
}

worktree_remove() {
  local target="" force=false help=false source source_kind canonical i found=false path gitdir common
  split_options sub '' '' "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=true ;;
      -h|--help) help=true ;;
      -*) usage_error_for worktree_remove_usage "worktree remove: unknown option: $1"; return ;;
      *)
        [ -z "$target" ] || { usage_error_for worktree_remove_usage "worktree remove: unexpected argument: $1"; return; }
        target="$1" ;;
    esac
    shift
  done
  [ "$help" = false ] || { worktree_remove_usage; return 0; }
  [ -n "$target" ] || { usage_error_for worktree_remove_usage 'worktree remove: PATH is required'; return; }
  source=$(worktree_source_repo) || return 1
  source_kind=$(repo_type "$source")
  case "$source_kind" in standard|nested) ;; *)
    printf 'mgit worktree remove: unsupported repository structure\n' >&2
    return 1
  esac
  canonical=$(canon_dir "$(resolve_path "$(expand_tilde "$target")" "$(pwd)")") || {
    printf 'mgit worktree remove: PATH is not an existing directory: %s\n' "$target" >&2
    return 1
  }
  collect_worktrees "$source"
  for i in "${!worktree_paths[@]}"; do
    capture_dir path "${worktree_paths[$i]}"
    [ "$path" = "$canonical" ] || continue
    found=true
    break
  done
  [ "$found" = true ] || {
    printf 'mgit worktree remove: not a worktree of this repository: %s\n' "$target" >&2
    return 1
  }
  gitdir=$(git_dir "$canonical")
  common=$(git_common_dir "$canonical")
  [ "$source_kind" != nested ] || [ "$canonical" != "$(canon_dir "$source/main")" ] || {
    printf 'mgit worktree remove: refusing to remove the required main worktree\n' >&2
    return 1
  }
  [ "$gitdir" != "$common" ] || {
    printf 'mgit worktree remove: refusing to remove the primary working tree\n' >&2
    return 1
  }
  if [ "$force" = true ]; then
    git -C "$source" worktree remove --force "$canonical"
  else
    git -C "$source" worktree remove "$canonical"
  fi
}

conversion_branch() {
  git -C "$1" symbolic-ref --quiet --short HEAD 2>/dev/null
}

validate_nested_structure() {
  local root="$1" branch changes count
  [ "$(repo_type "$root")" = standard ] || return 1
  branch=$(conversion_branch "$root") || {
    printf 'mgit structure nested: skipping detached repository: %s\n' "$root" >&2
    return 1
  }
  changes=$(git -C "$root" status --porcelain) || return 1
  [ -z "$changes" ] || {
    printf 'mgit structure nested: skipping dirty repository: %s\n' "$root" >&2
    return 1
  }
  count=$(git -C "$root" worktree list --porcelain 2>/dev/null | awk '/^worktree / { n++ } END { print n + 0 }')
  [ "$count" -eq 1 ] || {
    printf 'mgit structure nested: skipping repository with linked worktrees: %s\n' "$root" >&2
    return 1
  }
  printf '%s' "$branch"
}

# Turn a clean standard checkout into the colocated mgit layout without deleting
# its former files. The original checkout is retained in .mgit-backup-<stamp>;
# a failed conversion restores its .git directory and leaves the failed attempt
# beside it for inspection.
structure_nested_repository() {
  local root="$1" branch="$2" parent name stamp stage failed backup
  parent=$(dirname "$root")
  name=$(basename "$root")
  stamp=$(date +%Y%m%d%H%M%S)
  stage="$parent/.${name}.mgit-nested-$stamp"
  failed="$parent/.${name}.mgit-failed-$stamp"
  backup="$root/.mgit-backup-$stamp"
  if [ -e "$stage" ] || [ -e "$failed" ]; then
    printf 'mgit structure nested: staging path already exists for %s\n' "$root" >&2
    return 1
  fi

  mv "$root" "$stage" || return 1
  if ! mkdir "$root" || ! mv "$stage/.git" "$root/.bare" || \
     ! git --git-dir="$root/.bare" config core.bare true || \
     ! printf 'gitdir: ./.bare\n' > "$root/.git" || \
     ! git -C "$root" worktree add main "$branch"; then
    printf 'mgit structure nested: conversion failed; restoring %s\n' "$root" >&2
    mv "$root" "$failed" 2>/dev/null || true
    if [ -d "$failed/.bare" ]; then
      mv "$failed/.bare" "$stage/.git" 2>/dev/null || true
    fi
    mv "$stage" "$root" 2>/dev/null || true
    printf 'mgit structure nested: failed attempt retained at %s\n' "$failed" >&2
    return 1
  fi
  if ! mv "$stage" "$backup"; then
    printf 'mgit structure nested: converted %s, but rollback backup remains at %s\n' "$root" "$stage" >&2
    return 1
  fi
  printf 'mgit: structured %s as nested (backup: %s)\n' "$root" "$backup"
}

structure_nested() {
  local mode="" unit root kind branch failed=false help=false
  split_options sub '' '' "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run)
        [ -z "$mode" ] || { usage_error_for structure_usage "structure nested: unexpected argument: $1"; return; }
        mode=--dry-run ;;
      -h|--help) help=true ;;
      *) usage_error_for structure_usage "structure nested: unexpected argument: $1"; return ;;
    esac
    shift
  done
  [ "$help" = false ] || { structure_usage; return 0; }
  for unit in "${repo_units[@]+"${repo_units[@]}"}"; do
    capture_dir root "$unit" || continue
    kind=$(repo_type "$root")
    case "$kind" in
      nested) printf 'mgit structure nested: already nested: %s\n' "$root" ;;
      standard)
        branch=$(validate_nested_structure "$root") || { failed=true; continue; }
        if [ "$mode" = --dry-run ]; then
          printf 'mgit structure nested: would restructure %s (%s -> main/)\n' "$root" "$branch"
        else
          structure_nested_repository "$root" "$branch" || failed=true
        fi ;;
      bare) printf 'mgit structure nested: skipping bare repository: %s\n' "$root" >&2; failed=true ;;
      *) printf 'mgit structure nested: skipping unsupported path: %s\n' "$root" >&2; failed=true ;;
    esac
  done
  [ "$failed" = false ]
}

validate_standard_structure() {
  local root="$1" paths=() path changes
  [ "$(repo_type "$root")" = nested ] || return 1
  while IFS= read -r -d '' path; do [ -n "$path" ] && paths+=("$path"); done < <(active_worktree_paths "$root")
  if [ ${#paths[@]} -ne 1 ] || [ "$(canon_dir "${paths[0]}")" != "$(canon_dir "$root/main")" ]; then
    printf 'mgit structure standard: skipping repository with non-main worktrees: %s\n' "$root" >&2
    return 1
  fi
  changes=$(git -C "$root/main" status --porcelain) || return 1
  [ -z "$changes" ] || {
    printf 'mgit structure standard: skipping dirty main worktree: %s\n' "$root" >&2
    return 1
  }
}

structure_standard_repository() {
  local root="$1" parent name stamp stage backup
  parent=$(dirname "$root")
  name=$(basename "$root")
  stamp=$(date +%Y%m%d%H%M%S)
  stage="$parent/.${name}.mgit-standard-$stamp"
  backup="$parent/.${name}.mgit-nested-backup-$stamp"
  [ ! -e "$stage" ] || return 1
  mv "$root" "$stage" || return 1
  if ! mv "$stage/.git" "$stage/.mgit-controller" || \
     ! mv "$stage/.bare" "$stage/.git" || \
     ! git --git-dir="$stage/.git" config core.bare false || \
     ! mv "$stage/main" "$root" || \
     ! mv "$root/.git" "$stage/.mgit-main-gitfile" || \
     ! mv "$stage/.git" "$root/.git"; then
    printf 'mgit structure standard: conversion failed; retained staging path: %s\n' "$stage" >&2
    return 1
  fi
  mv "$stage" "$backup" || {
    printf 'mgit structure standard: converted %s, but backup remains at %s\n' "$root" "$stage" >&2
    return 1
  }
  printf 'mgit: structured %s as standard (backup: %s)\n' "$root" "$backup"
}

structure_standard() {
  local mode="" unit root kind failed=false help=false
  split_options sub '' '' "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run)
        [ -z "$mode" ] || { usage_error_for structure_usage "structure standard: unexpected argument: $1"; return; }
        mode=--dry-run ;;
      -h|--help) help=true ;;
      *) usage_error_for structure_usage "structure standard: unexpected argument: $1"; return ;;
    esac
    shift
  done
  [ "$help" = false ] || { structure_usage; return 0; }
  for unit in "${repo_units[@]+"${repo_units[@]}"}"; do
    capture_dir root "$unit" || continue
    kind=$(repo_type "$root")
    case "$kind" in
      standard) printf 'mgit structure standard: already standard: %s\n' "$root" ;;
      nested)
        validate_standard_structure "$root" || { failed=true; continue; }
        if [ "$mode" = --dry-run ]; then
          printf 'mgit structure standard: would restructure %s (main/ -> repository root)\n' "$root"
        else
          structure_standard_repository "$root" || failed=true
        fi ;;
      *) printf 'mgit structure standard: skipping unsupported repository: %s\n' "$root" >&2; failed=true ;;
    esac
  done
  [ "$failed" = false ]
}

structure_command() {
  local target="${1:-}"
  [ $# -gt 0 ] && shift
  case "$target" in
    nested) structure_nested "$@" ;;
    standard) structure_standard "$@" ;;
    -h|--help)
      [ $# -eq 0 ] || { usage_error_for structure_usage "structure: unexpected argument: $1"; return; }
      structure_usage ;;
    '') usage_error_for structure_usage 'structure: expected standard or nested'; return ;;
    *) usage_error_for structure_usage "structure: unknown command: $target"; return ;;
  esac
}

worktree_command() {
  local action="${1:-}"
  [ $# -gt 0 ] && shift
  case "$action" in
    list|status)
      local help=false
      while [ $# -gt 0 ]; do
        case "$1" in
          -h|--help) help=true ;;
          *) usage_error_for worktree_usage "worktree $action: unexpected argument: $1"; return ;;
        esac
        shift
      done
      [ "$help" = false ] || { worktree_usage; return 0; }
      if [ "$action" = list ]; then worktree_list; else worktree_status; fi ;;
    add)    worktree_add "$@" ;;
    remove) worktree_remove "$@" ;;
    -h|--help)
      [ $# -eq 0 ] || { usage_error_for worktree_usage "worktree: unexpected argument: $1"; return; }
      worktree_usage ;;
    '') usage_error_for worktree_usage 'worktree: expected list, status, add, or remove'; return ;;
    *) usage_error_for worktree_usage "worktree: unknown command: $action"; return ;;
  esac
}

sync_print_detail() {
  local detail="$1" line
  while IFS= read -r line || [ -n "$line" ]; do
    printf '  %s\n' "$line"
  done <<< "$detail"
}

sync_commit_noun() {
  if [ "$1" -eq 1 ]; then
    printf 'commit'
  else
    printf 'commits'
  fi
}

sync_confirm_action() {
  local answer
  while true; do
    printf 'mgit sync: %s: %s? [y/N]\n' "$1" "$2" >&2
    if ! IFS= read -r answer; then
      printf 'mgit sync: interactive input ended\n' >&2
      return 2
    fi
    case "$answer" in
      y|Y|yes|YES) return 0 ;;
      n|N|no|NO|'') return 1 ;;
      *) printf 'mgit sync: answer y or n\n' >&2 ;;
    esac
  done
}

# Fetch once per repository and remote; linked worktrees of one repository
# share its refs, so concurrent fetches there would race for ref locks.
sync_fetch_worker() {
  [ "${sync_fetch_owner[$1]}" = "$1" ] || return 0
  git -C "${repos[$1]}" fetch --quiet "${sync_remote[$1]}"
}

# Results go to standard output; skips, warnings, progress and prompts to
# standard error.
sync_report() {
  printf 'mgit sync: %s: %s\n' "$1" "$2"
  [ -z "${3:-}" ] || sync_print_detail "$3"
}

sync_warn() {
  sync_report "$@" >&2
}

# Count a checkout left behind and keep its reason for the closing detail.
# A user's -i refusal is skipped but, unlike the rest, does not fail sync.
sync_outcome() {
  case "$2" in
    failed) sync_failed=$((sync_failed + 1)); failed=true ;;
    skipped) sync_skipped=$((sync_skipped + 1)); failed=true ;;
    refused) sync_skipped=$((sync_skipped + 1)) ;;
  esac
  sync_details+=("$1: $3")
}

sync_command() {
  local help=false interactive=false verbose=false d label index branch upstream remote key
  local status_output counts ahead behind output owner detail synced=0 pulled=0 pushed=0
  local failed=false current=0 total=${#repos[@]} answer_status j common prediction conflicts
  local dirty held not_reached=0 line
  local fetch_keys=()

  split_options sub '' '' "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) help=true ;;
      -i|--interactive) interactive=true ;;
      -v|--verbose) verbose=true ;;
      *) usage_error_for sync_usage "sync: unexpected argument: $1"; return ;;
    esac
    shift
  done
  [ "$help" = false ] || { sync_usage; return 0; }
  sync_skipped=0
  sync_failed=0
  sync_details=()

  # Decide serially which checkouts fetch, so the pool never runs two
  # fetches into the same repository and remote.
  sync_kind=()
  sync_branch=()
  sync_remote=()
  sync_fetch_owner=()
  for index in "${!repos[@]}"; do
    d="${repos[$index]}"
    sync_kind[index]=$(repo_type "$d")
    sync_branch[index]=""
    sync_remote[index]=""
    sync_fetch_owner[index]=-1
    [ "${sync_kind[index]}" != bare ] || continue
    branch=$(git -C "$d" symbolic-ref --quiet --short HEAD 2>/dev/null) || continue
    sync_branch[index]="$branch"
    git -C "$d" rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1 || continue
    remote=$(git -C "$d" config "branch.$branch.remote" 2>/dev/null) || continue
    [ "$remote" != . ] || continue
    sync_remote[index]="$remote"
    common="$d"
    if capture_path git_common_dir "$d"; then common="$captured_path"; fi
    key="$common"$'\t'"$remote"
    sync_fetch_owner[index]=$index
    for j in "${!fetch_keys[@]}"; do
      if [ "${fetch_keys[j]}" = "$key" ]; then
        sync_fetch_owner[index]="${fetch_keys[j + 1]}"
        break
      fi
    done
    [ "${sync_fetch_owner[index]}" != "$index" ] || fetch_keys+=("$key" "$index")
  done
  runner_start || return 1
  runner_run sync_fetch_worker
  for index in "${!repos[@]}"; do
    d="${repos[$index]}"
    label="${repo_labels[$index]}"
    branch="${sync_branch[index]}"
    current=$((current + 1))
    [ "$verbose" = false ] || printf 'mgit sync: [%d/%d] %s: checking\n' "$current" "$total" "$label" >&2
    if [ "${sync_kind[index]}" = bare ]; then
      [ "$verbose" = false ] || sync_warn "$label" 'bare repository (skipped)'
      sync_outcome "$label" skipped 'bare repository'
      continue
    fi
    if ! status_output=$(git -C "$d" status --short 2>&1); then
      sync_warn "$label" 'status failed' "$status_output"
      sync_outcome "$label" failed 'status failed'
      continue
    fi
    # A dirty checkout is never changed, but its counts are still reported,
    # so commits it holds are not stranded silently.
    dirty=""
    if [ -n "$status_output" ]; then
      sync_warn "$label" 'local changes (skipped)' "$status_output"
      dirty='local changes, '
    fi
    if [ -z "$branch" ]; then
      [ -n "$dirty" ] || sync_warn "$label" 'detached HEAD (skipped)'
      sync_outcome "$label" skipped "${dirty}detached HEAD"
      continue
    fi
    if ! upstream=$(git -C "$d" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
      [ -n "$dirty" ] || sync_warn "$label" "branch $branch has no upstream (skipped)"
      sync_outcome "$label" skipped "${dirty}branch $branch has no upstream"
      continue
    fi
    held=""
    if counts=$(git -C "$d" rev-list --left-right --count 'HEAD...@{upstream}' 2>/dev/null); then
      ahead="${counts%%[[:space:]]*}"
      behind="${counts##*[[:space:]]}"
      held=", $ahead ahead, $behind behind"
    fi
    owner="${sync_fetch_owner[index]}"
    if [ "$owner" -ge 0 ] && [ "$(runner_status "$owner")" -ne 0 ]; then
      detail=$(cat "$runner_dir/$owner.err")
      sync_warn "$label" "fetch from ${sync_remote[index]} failed" "$detail"
      [ -z "$held" ] || held="$held (stale)"
      sync_outcome "$label" failed "${dirty}fetch from ${sync_remote[index]} failed$held"
      continue
    fi
    if [ -z "$held" ]; then
      sync_warn "$label" "cannot compare with upstream $upstream"
      sync_outcome "$label" failed "${dirty}cannot compare with upstream $upstream"
      continue
    fi
    if [ -n "$dirty" ]; then
      sync_outcome "$label" skipped "local changes$held"
    elif [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
      # Predict the merge in memory; any status but 0 or 1, as from a Git
      # older than 2.38, leaves the plain warning.
      prediction="" detail=""
      if output=$(git -C "$d" merge-tree --write-tree --name-only --no-messages HEAD '@{upstream}' 2>/dev/null); then
        prediction=', merge would be clean'
      elif [ $? -eq 1 ]; then
        detail="${output#*$'\n'}"
        [ "$detail" != "$output" ] || detail=""
        conflicts=0
        [ -z "$detail" ] || conflicts=$(printf '%s\n' "$detail" | wc -l | tr -d ' ')
        prediction=", merge would conflict in $(plural "$conflicts" file files)"
        [ "$verbose" = true ] || detail=""
      fi
      sync_warn "$label" "diverged from $upstream, $ahead ahead and $behind behind$prediction (skipped)" "$detail"
      sync_outcome "$label" skipped "diverged from $upstream$prediction$held"
    elif [ "$behind" -gt 0 ]; then
      if [ "$interactive" = true ]; then
        sync_confirm_action "$label" "pull $behind $(sync_commit_noun "$behind") into $branch from $upstream"
        answer_status=$?
        case "$answer_status" in
          1) sync_warn "$label" 'pull skipped'; sync_outcome "$label" refused "pull skipped by user$held"; continue ;;
          2) not_reached=$((total - current + 1)); break ;;
        esac
      fi
      [ "$verbose" = false ] || sync_warn "$label" pulling
      if ! output=$(git -C "$d" merge --ff-only --quiet '@{upstream}' 2>&1); then
        sync_warn "$label" 'pull failed' "$output"
        sync_outcome "$label" failed "pull failed$held"
        continue
      fi
      sync_report "$label" "pulled $behind $(sync_commit_noun "$behind")"
      pulled=$((pulled + 1))
    elif [ "$ahead" -gt 0 ]; then
      if [ "$interactive" = true ]; then
        sync_confirm_action "$label" "push $ahead $(sync_commit_noun "$ahead")"
        answer_status=$?
        case "$answer_status" in
          1)
            sync_warn "$label" "push skipped ($ahead $(sync_commit_noun "$ahead") ahead)"
            sync_outcome "$label" refused "push skipped by user$held"
            continue
            ;;
          2) not_reached=$((total - current + 1)); break ;;
        esac
      fi
      [ "$verbose" = false ] || sync_warn "$label" pushing
      if ! output=$(git -C "$d" push --quiet 2>&1); then
        sync_warn "$label" 'push failed' "$output"
        sync_outcome "$label" failed "push failed$held"
        continue
      fi
      sync_report "$label" "pushed $ahead $(sync_commit_noun "$ahead")"
      pushed=$((pushed + 1))
    else
      synced=$((synced + 1))
    fi
  done
  runner_cleanup

  # One tally that always sums to the selection, then each checkout left
  # behind, so a skip early in a long run is repeated where it is seen.
  local tally
  tally="$synced in sync, $pulled pulled, $pushed pushed, $sync_skipped skipped, $sync_failed failed"
  [ "$not_reached" -eq 0 ] || tally="$tally, $not_reached not reached"
  printf 'mgit sync: %s: %s\n' "$(plural "$total" repository repositories)" "$tally"
  for line in "${sync_details[@]+"${sync_details[@]}"}"; do
    printf '  %s\n' "$line"
  done
  [ "$failed" = false ] && [ "$not_reached" -eq 0 ]
}

# Overview is a read-only estate view. The collector prints one tab-separated
# fact per line for a checkout, with - for an empty value because read
# collapses adjacent tabs, so it can run wherever its output is captured;
# the renderers classify those facts and never run Git themselves. Nothing here
# fetches, writes the index or changes a ref.
overview_automation() {
  case "$1" in
    automation/*|dependabot/*|renovate/*) printf true ;;
    *) printf false ;;
  esac
}

overview_age_days() {
  if [ -n "$2" ]; then printf '%s' $((($1 - $2) / 86400)); else printf -- -; fi
}

# Read one collector line into key and fields a to e, restoring empty values.
overview_read() {
  IFS=$'\t' read -r key a b c d e || return 1
  [ "$a" != - ] || a=""
  [ "$b" != - ] || b=""
  [ "$c" != - ] || c=""
  [ "$d" != - ] || d=""
  [ "$e" != - ] || e=""
}

# Collect the facts for checkout $1. $2 is the stale threshold in days, $3 the
# current time in seconds, and $4 is false when another checkout of the same
# repository has already reported its worktrees and branches.
overview_collect() {
  local dir="$1" stale_days="$2" now="$3" branch_facts="$4"
  local type status_out line head="" upstream="" ab="" ahead=0 behind=0 state=none
  local staged=0 modified=0 untracked=0 conflicted=0 stashes=0 xy
  local linked=0 prunable=0 detached_worktrees=0 path="" checkout block_detached=false
  local block_prunable=false block_branch="" first=true in_use=() item kept
  local default="" default_local="" merged=() name track stamp symref reasons cherry
  local fetch_head stamp_fetch
  export GIT_OPTIONAL_LOCKS=0
  capture_dir checkout "$dir" || return 1
  if is_bare_repo "$dir"; then type=bare; else type=checkout; fi
  printf 'type\t%s\n' "$type"
  if [ "$type" = checkout ]; then
    status_out=$(git -C "$dir" status --porcelain=v2 --branch 2>/dev/null) || {
      printf 'cannot read status\n' >&2
      return 1
    }
    while IFS= read -r line; do
      case "$line" in
        '# branch.head '*) head="${line#\# branch.head }" ;;
        '# branch.upstream '*) upstream="${line#\# branch.upstream }"; state=gone ;;
        '# branch.ab '*) ab="${line#\# branch.ab }"; state=tracking ;;
        '1 '*|'2 '*)
          xy="${line:2:2}"
          [ "${xy:0:1}" = . ] || staged=$((staged + 1))
          [ "${xy:1:1}" = . ] || modified=$((modified + 1))
          ;;
        'u '*) conflicted=$((conflicted + 1)) ;;
        '? '*) untracked=$((untracked + 1)) ;;
      esac
    done <<< "$status_out"
    if [ -n "$ab" ]; then
      ahead="${ab%% *}"; ahead="${ahead#+}"
      behind="${ab##* }"; behind="${behind#-}"
    fi
    [ "$head" != '(detached)' ] || head=""
    # Stashes, like worktrees and branches, belong to the whole repository.
    if [ "$branch_facts" = true ]; then
      stashes=$(git -C "$dir" stash list 2>/dev/null | wc -l)
      stashes=$((stashes + 0))
    fi
  else
    head=$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null) || head=""
  fi
  printf 'head\t%s\n' "${head:--}"
  printf 'upstream\t%s\t%s\t%s\t%s\n' "$state" "${upstream:--}" "$ahead" "$behind"
  printf 'changes\t%s\t%s\t%s\t%s\n' "$staged" "$modified" "$untracked" "$conflicted"
  printf 'stashes\t%s\n' "$stashes"
  stamp=$(git -C "$dir" log -1 --format=%ct 2>/dev/null) || stamp=""
  printf 'commit_age\t%s\n' "$(overview_age_days "$now" "$stamp")"
  fetch_head=$(git -C "$dir" rev-parse --git-path FETCH_HEAD 2>/dev/null) || fetch_head=""
  case "$fetch_head" in /*|'') ;; *) fetch_head="$dir/$fetch_head" ;; esac
  stamp_fetch=""
  if [ -n "$fetch_head" ] && [ -f "$fetch_head" ]; then
    stamp_fetch=$(date -r "$fetch_head" +%s 2>/dev/null) || stamp_fetch=""
  fi
  printf 'fetch_age\t%s\n' "$(overview_age_days "$now" "$stamp_fetch")"
  [ "$branch_facts" = true ] || return 0

  # The first worktree entry is the main worktree or the bare store. A branch
  # checked out in any worktree is in use and never reported as obsolete.
  while IFS= read -r line; do
    case "$line" in
      'worktree '*) path="${line#worktree }"; block_detached=false; block_prunable=false; block_branch="" ;;
      detached) block_detached=true ;;
      prunable*) block_prunable=true ;;
      'branch refs/heads/'*) block_branch="${line#branch refs/heads/}" ;;
      '')
        if [ -n "$path" ]; then
          [ -z "$block_branch" ] || in_use+=("$block_branch")
          if [ "$first" = false ]; then
            linked=$((linked + 1))
            [ "$block_prunable" = false ] || prunable=$((prunable + 1))
            if [ "$block_detached" = true ] && [ "$block_prunable" = false ] &&
              [ "$(canon_dir "$path")" != "$checkout" ]; then
              detached_worktrees=$((detached_worktrees + 1))
            fi
          fi
          first=false
        fi
        path=""
        ;;
    esac
  done < <(git -C "$dir" worktree list --porcelain 2>/dev/null; printf '\n')
  printf 'worktrees\t%s\t%s\t%s\n' "$linked" "$prunable" "$detached_worktrees"

  default=$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || default=""
  if [ -n "$default" ]; then
    default_local="${default#*/}"
  else
    for name in main master; do
      if git -C "$dir" show-ref --verify --quiet "refs/heads/$name"; then
        default="$name"; default_local="$name"; break
      fi
    done
  fi
  printf 'default\t%s\n' "${default:--}"
  if [ -n "$default" ]; then
    while IFS= read -r line; do merged+=("$line"); done < <(
      git -C "$dir" for-each-ref --merged="$default" --format='%(refname)' refs/heads refs/remotes 2>/dev/null)
  fi
  while IFS=$'\t' read -r name stamp track; do
    { [ -n "$name" ] && [ "$name" != "$default_local" ]; } || continue
    kept=false
    for item in "${in_use[@]+"${in_use[@]}"}"; do [ "$item" != "$name" ] || kept=true; done
    [ "$kept" = false ] || continue
    reasons=""
    if [ -n "$default" ]; then
      if selected_path_seen "refs/heads/$name" "${merged[@]+"${merged[@]}"}"; then
        reasons=merged
      else
        cherry=$(git -C "$dir" cherry "$default" "$name" 2>/dev/null) || cherry=""
        case $'\n'"$cherry" in
          *$'\n+'*|$'\n') ;;
          *) reasons=equivalent ;;
        esac
      fi
    fi
    [ "$track" != '[gone]' ] || reasons="${reasons:+$reasons,}gone"
    case "$reasons" in
      merged*|equivalent*) ;;
      *) [ -z "$stamp" ] || [ $((now - stamp)) -le $((stale_days * 86400)) ] || reasons="${reasons:+$reasons,}stale" ;;
    esac
    [ -n "$reasons" ] || continue
    printf 'branch\tlocal\t%s\t%s\t%s\t%s\n' "$name" "$reasons" \
      "$(overview_age_days "$now" "$stamp")" "$(overview_automation "$name")"
  done < <(git -C "$dir" for-each-ref --format='%(refname:short)%09%(committerdate:unix)%09%(upstream:track)' refs/heads 2>/dev/null)
  while IFS=$'\t' read -r name stamp symref; do
    { [ -n "$name" ] && [ -z "$symref" ] && [ "${name#*/}" != "$default_local" ]; } || continue
    kept=false
    for item in "${in_use[@]+"${in_use[@]}"}"; do [ "$item" != "${name#*/}" ] || kept=true; done
    [ "$kept" = false ] || continue
    reasons=""
    if [ -n "$default" ] && selected_path_seen "refs/remotes/$name" "${merged[@]+"${merged[@]}"}"; then
      reasons=merged
    elif [ -n "$stamp" ] && [ $((now - stamp)) -gt $((stale_days * 86400)) ]; then
      reasons=stale
    fi
    [ -n "$reasons" ] || continue
    printf 'branch\tremote\t%s\t%s\t%s\t%s\n' "$name" "$reasons" \
      "$(overview_age_days "$now" "$stamp")" "$(overview_automation "${name#*/}")"
  done < <(git -C "$dir" for-each-ref --format='%(refname:short)%09%(committerdate:unix)%09%(symref)' refs/remotes 2>/dev/null)
  return 0
}

json_string() {
  local s="$1" out="" c i
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  case "$s" in
    *[[:cntrl:]]*)
      for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"
        case "$c" in [[:cntrl:]]) printf -v c '\\u%04x' "'$c" ;; esac
        out+="$c"
      done
      s="$out"
      ;;
  esac
  printf '"%s"' "$s"
}

json_number() { if [ -n "$1" ]; then printf '%s' "$1"; else printf null; fi; }

plural() { if [ "$1" -eq 1 ]; then printf '%s %s' "$1" "$2"; else printf '%s %s' "$1" "$3"; fi; }

# Turn one checkout's facts into overview_findings and overview_branch_lines,
# and set overview_state to clean or attention.
overview_classify() {
  local facts="$1" key a b c d e line
  local type="" head="" upstream_state=none ahead=0 behind=0 stashes=0
  overview_findings=()
  overview_branch_lines=()
  while overview_read; do
    case "$key" in
      type) type="$a" ;;
      head) head="$a" ;;
      upstream) upstream_state="$a"; ahead="$c"; behind="$d" ;;
      changes)
        [ "$d" -eq 0 ] || overview_findings+=("$d conflicted")
        [ "$a" -eq 0 ] || overview_findings+=("$a staged")
        [ "$b" -eq 0 ] || overview_findings+=("$b modified")
        [ "$c" -eq 0 ] || overview_findings+=("$c untracked")
        ;;
      stashes) stashes="$a" ;;
      worktrees)
        [ "$b" -eq 0 ] || overview_findings+=("$(plural "$b" 'prunable worktree' 'prunable worktrees')")
        [ "$c" -eq 0 ] || overview_findings+=("$(plural "$c" 'detached worktree' 'detached worktrees')")
        ;;
      branch)
        line="$b ($a): ${c//,/, }"
        case ",$c," in *,stale,*) [ -z "$d" ] || line="$line, $d days old" ;; esac
        [ "$e" = false ] || line="$line, automation"
        overview_branch_lines+=("$line")
        ;;
    esac
  done <<< "$facts"
  if [ "$type" = checkout ]; then
    if [ -z "$head" ]; then
      overview_findings=("detached HEAD" "${overview_findings[@]+"${overview_findings[@]}"}")
    else
      case "$upstream_state" in
        none) overview_findings+=("no upstream") ;;
        gone) overview_findings+=("upstream gone") ;;
      esac
    fi
    [ "$ahead" -eq 0 ] || overview_findings+=("ahead $ahead")
    [ "$behind" -eq 0 ] || overview_findings+=("behind $behind")
    [ "$stashes" -eq 0 ] || overview_findings+=("$(plural "$stashes" stash stashes)")
  fi
  [ ${#overview_branch_lines[@]} -eq 0 ] ||
    overview_findings+=("$(plural "${#overview_branch_lines[@]}" 'obsolete branch' 'obsolete branches')")
  if [ ${#overview_findings[@]} -eq 0 ]; then overview_state=clean; else overview_state=attention; fi
}

json_optional_string() { if [ -n "$1" ]; then json_string "$1"; else printf null; fi; }

overview_json_repository() {
  local label="$1" path="$2" state="$3" facts="$4" error="$5" key a b c d e first item type=""
  local branches=()
  printf '{"label":%s,"path":%s,"state":"%s"' "$(json_string "$label")" "$(json_string "$path")" "$state"
  if [ "$state" = failed ]; then
    printf ',"error":%s}' "$(json_string "$error")"
    return
  fi
  while overview_read; do
    case "$key" in
      type)
        type="$a"
        if [ "$a" = bare ]; then printf ',"bare":true'; else printf ',"bare":false'; fi ;;
      head)
        if [ -n "$a" ] || [ "$type" = bare ]; then
          printf ',"branch":%s,"detached":false' "$(json_optional_string "$a")"
        else
          printf ',"branch":null,"detached":true'
        fi ;;
      upstream)
        printf ',"upstream":{"state":"%s","name":%s,"ahead":%s,"behind":%s}' \
          "$a" "$(json_optional_string "$b")" "$c" "$d" ;;
      changes) printf ',"changes":{"staged":%s,"modified":%s,"untracked":%s,"conflicted":%s}' "$a" "$b" "$c" "$d" ;;
      stashes) printf ',"stashes":%s' "$a" ;;
      commit_age) printf ',"last_commit_age_days":%s' "$(json_number "$a")" ;;
      fetch_age) printf ',"last_fetch_age_days":%s' "$(json_number "$a")" ;;
      worktrees) printf ',"worktrees":{"linked":%s,"prunable":%s,"detached":%s}' "$a" "$b" "$c" ;;
      default) printf ',"default_branch":%s' "$(json_optional_string "$a")" ;;
      branch)
        branches+=("$(printf '{"name":%s,"scope":"%s","reasons":["%s"],"age_days":%s,"automation":%s}' \
          "$(json_string "$b")" "$a" "${c//,/\",\"}" "$(json_number "$d")" "$e")") ;;
    esac
  done <<< "$facts"
  printf ',"obsolete_branches":['
  first=true
  for item in "${branches[@]+"${branches[@]}"}"; do
    [ "$first" = true ] || printf ','
    printf '%s' "$item"; first=false
  done
  printf '],"findings":['
  first=true
  for item in "${overview_findings[@]+"${overview_findings[@]}"}"; do
    [ "$first" = true ] || printf ','
    json_string "$item"; first=false
  done
  printf ']}'
}

overview_worker() {
  overview_collect "${repos[$1]}" "$overview_stale_days" "$overview_now" "${overview_branch_facts[$1]}"
}

overview_command() {
  local json=false verbose=false stale_days=30 i d label path common facts error status
  local clean=0 attention=0 failed=0 seen_common=() first=true line
  split_options sub '' --stale-days "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=true ;;
      -v|--verbose) verbose=true ;;
      --stale-days)
        [ $# -ge 2 ] || { usage_error_for overview_usage '--stale-days requires a number of days'; return; }
        case "$2" in
          ''|*[!0-9]*|0*) usage_error_for overview_usage "--stale-days requires a positive whole number of days: $2"; return ;;
        esac
        stale_days="$2"; shift ;;
      -h|--help) overview_usage; return 0 ;;
      *) usage_error_for overview_usage "overview: unexpected argument: $1"; return ;;
    esac
    shift
  done
  overview_stale_days="$stale_days"
  overview_now=$(date +%s)
  # Repository-wide facts belong to the first selected checkout of each
  # repository, so decide that serially before the pool starts.
  overview_branch_facts=()
  for i in "${!repos[@]}"; do
    overview_branch_facts[i]=true
    if capture_path git_common_dir "${repos[$i]}"; then
      common="$captured_path"
      if selected_path_seen "$common" "${seen_common[@]+"${seen_common[@]}"}"; then
        overview_branch_facts[i]=false
      else
        seen_common+=("$common")
      fi
    fi
  done
  runner_start || return 1
  runner_run overview_worker
  if [ "$json" = true ]; then
    printf '{"tool":"mgit","command":"overview","version":%s,"stale_days":%s,"repositories":[' \
      "$(json_string "$MGIT_VERSION")" "$stale_days"
  fi
  for i in "${!repos[@]}"; do
    d="${repos[$i]}"
    label="${repo_labels[$i]}"
    capture_dir path "$d" || path="$d"
    error=""
    facts=""
    if [ "$(runner_status "$i")" -eq 0 ]; then
      facts=$(cat "$runner_dir/$i.out")
      overview_classify "$facts"
      status="$overview_state"
    else
      status=failed
      IFS= read -r error < "$runner_dir/$i.err" || true
      [ -n "$error" ] || error="cannot read repository"
    fi
    case "$status" in
      clean) clean=$((clean + 1)) ;;
      attention) attention=$((attention + 1)) ;;
      failed) failed=$((failed + 1)) ;;
    esac
    if [ "$json" = true ]; then
      [ "$first" = true ] || printf ','
      first=false
      overview_json_repository "$label" "$path" "$status" "$facts" "$error"
      continue
    fi
    case "$status" in
      clean) [ "$verbose" = false ] || printf '%s%s%s%s: clean\n' "$BOLD" "$YELLOW" "$label" "$CLEAR" ;;
      failed) printf '%s%s%s%s: failed: %s\n' "$BOLD" "$YELLOW" "$label" "$CLEAR" "$error" ;;
      attention)
        line=$(printf '%s, ' "${overview_findings[@]}")
        printf '%s%s%s%s: %s\n' "$BOLD" "$YELLOW" "$label" "$CLEAR" "${line%, }"
        for line in "${overview_branch_lines[@]+"${overview_branch_lines[@]}"}"; do
          printf '  %s\n' "$line"
        done
        ;;
    esac
  done
  runner_cleanup
  if [ "$json" = true ]; then
    printf '],"summary":{"repositories":%s,"clean":%s,"attention":%s,"failed":%s}}\n' \
      "${#repos[@]}" "$clean" "$attention" "$failed"
  else
    printf 'mgit overview: %s: %s clean, %s need attention, %s failed\n' \
      "$(plural "${#repos[@]}" repository repositories)" "$clean" "$attention" "$failed"
  fi
  [ "$failed" -eq 0 ]
}

# The shared runner runs one worker function per selected checkout in a
# bounded pool of background subshells. Each worker's stdout, stderr and exit
# status land in files under a private directory, so results can be rendered
# in selection order once every worker has finished. Bash 3.2 has no wait -n,
# so a slot is freed by waiting on the oldest running worker.
runner_jobs=8
runner_dir=""
runner_pids=()

runner_cleanup() {
  [ -z "$runner_dir" ] || rm -rf "$runner_dir"
  runner_dir=""
}

runner_start() {
  runner_dir=$(mktemp -d "${TMPDIR:-/tmp}/mgit.XXXXXX") || {
    printf 'mgit: cannot create a temporary directory\n' >&2
    return 1
  }
  trap runner_cleanup EXIT
  trap 'runner_abort; exit 130' INT
  trap 'runner_abort; exit 143' TERM
}

runner_abort() {
  local pid
  for pid in "${runner_pids[@]+"${runner_pids[@]}"}"; do
    kill "$pid" 2>/dev/null || true
  done
  runner_progress_clear
  runner_cleanup
}

# One redrawn line on stderr, only when stderr is a terminal.
runner_progress() {
  local done="$1" total="$2" label="$3" width=10 filled bar=""
  [ -t 2 ] || return 0
  filled=$((done * width / total))
  while [ ${#bar} -lt "$filled" ]; do bar="$bar#"; done
  while [ ${#bar} -lt "$width" ]; do bar="$bar-"; done
  printf '\r\033[K[%s] %d/%d %s' "$bar" "$done" "$total" "$label" >&2
}

runner_progress_clear() {
  [ -t 2 ] || return 0
  printf '\r\033[K' >&2
}

# Run "$1 INDEX" for every index of repos[]. Workers cannot read the terminal,
# prompt for credentials or open an editor, so nothing waits on input unseen.
runner_run() {
  local worker="$1" total=${#repos[@]} next=0 oldest=0
  runner_pids=()
  while [ "$oldest" -lt "$total" ]; do
    while [ "$next" -lt "$total" ] && [ $((next - oldest)) -lt "$runner_jobs" ]; do
      (
        export GIT_TERMINAL_PROMPT=0 GIT_EDITOR=false GIT_SEQUENCE_EDITOR=false
        trap - EXIT INT TERM
        status=0
        "$worker" "$next" > "$runner_dir/$next.out" 2> "$runner_dir/$next.err" < /dev/null || status=$?
        printf '%s\n' "$status" > "$runner_dir/$next.rc"
      ) &
      runner_pids+=("$!")
      next=$((next + 1))
    done
    wait "${runner_pids[oldest]}" 2>/dev/null || true
    oldest=$((oldest + 1))
    runner_progress "$oldest" "$total" "${repo_labels[oldest - 1]}"
  done
  runner_pids=()
  runner_progress_clear
}

runner_status() {
  local status=""
  [ ! -f "$runner_dir/$1.rc" ] || IFS= read -r status < "$runner_dir/$1.rc" || true
  printf '%s' "${status:-1}"
}

# Learned output templates. A template holds a Git command's normal output with
# each checkout's own details replaced by placeholders; a checkout whose output
# matches it exactly, on exit 0, counts as quiet. Nothing is built in.
template_dir() { printf '%s/mgit/templates' "${XDG_CONFIG_HOME:-$HOME/.config}"; }

# Expand Git aliases as Git would, so `st` and `status -sb` share a template.
# Shell aliases (`!`) are left as they are.
resolve_git_aliases() {
  local expansion depth=0
  local -a words
  resolved_command=("$@")
  while [ "$depth" -lt 10 ]; do
    expansion=$(git config --get "alias.${resolved_command[0]}" 2>/dev/null) || return 0
    case "$expansion" in ''|'!'*) return 0 ;; esac
    read -r -a words <<< "$expansion"
    resolved_command=("${words[@]}" "${resolved_command[@]:1}")
    depth=$((depth + 1))
  done
}

# One readable file per command: words joined by `_`, and every other
# character outside [A-Za-z0-9.,=@+-] written as %XX, so names stay distinct.
template_file() {
  local LC_ALL=C word name="" separator="" i c
  for word in "$@"; do
    name="$name$separator"
    separator=_
    i=0
    while [ "$i" -lt ${#word} ]; do
      c="${word:i:1}"
      case "$c" in
        [A-Za-z0-9.,=@+-]) name="$name$c" ;;
        *) name="$name$(printf '%%%02X' "'$c")" ;;
      esac
      i=$((i + 1))
    done
  done
  printf '%s/%s.template' "$(template_dir)" "$name"
}

# Read template $1 into template_out and template_err, without trailing newlines.
template_read() {
  local line out="" err=""
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      stdout:*) line="${line#stdout:}"; out="$out${line# }"$'\n' ;;
      stderr:*) line="${line#stderr:}"; err="$err${line# }"$'\n' ;;
    esac
  done < "$1"
  template_out=$(printf '%s' "$out")
  template_err=$(printf '%s' "$err")
}

# Set detail_values and detail_names for checkout $1 of repository root $2,
# with detail_order listing them longest value first, so a branch name inside
# a path or URL is never replaced before the path or URL itself.
checkout_details() {
  local d="$1" branch="" upstream remote="" url="" path i best
  branch=$(git -C "$d" symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=""
  upstream=$(git -C "$d" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || upstream=""
  [ -z "$branch" ] || remote=$(git -C "$d" config --get "branch.$branch.remote" 2>/dev/null) || remote=""
  [ -n "$remote" ] || ! git -C "$d" config --get remote.origin.url >/dev/null 2>&1 || remote=origin
  [ -z "$remote" ] || url=$(git -C "$d" config --get "remote.$remote.url" 2>/dev/null) || url=""
  path=$(cd "$d" && pwd -P)
  detail_values=("$path" "$url" "$upstream" "$remote" "$branch" "${2##*/}")
  detail_names=('{path}' '{remote-url}' '{upstream}' '{remote}' '{branch}' '{repository}')
  detail_order=()
  while [ ${#detail_order[@]} -lt 6 ]; do
    best=""
    for i in 0 1 2 3 4 5; do
      case " ${detail_order[*]-} " in *" $i "*) continue ;; esac
      [ -n "$best" ] && [ ${#detail_values[i]} -le ${#detail_values[best]} ] || best=$i
    done
    detail_order+=("$best")
  done
}

# Print $1 with the current checkout's details replaced by their placeholders.
# Values shorter than two characters are left alone.
normalise_text() {
  local text="$1" i value name
  for i in "${detail_order[@]}"; do
    value="${detail_values[i]}"
    name="${detail_names[i]}"
    [ ${#value} -ge 2 ] || continue
    text="${text//"$value"/$name}"
  done
  printf '%s' "$text"
}

# A pass-through worker. After a Git command exits 0, its output is normalised
# for learning, or compared with the command's template.
dispatch_worker() {
  local d="${repos[$1]}" out err
  if [ "$runner_raw" = true ]; then
    ( cd "$d" && "${runner_command[@]}" )
    return
  fi
  ( cd "$d" && git "${runner_command[@]}" ) || return
  [ "$runner_template" = true ] || [ "$learn_mode" = true ] || return 0
  checkout_details "$d" "${repo_roots[$1]}"
  out=$(normalise_text "$(cat "$runner_dir/$1.out")")
  err=$(normalise_text "$(cat "$runner_dir/$1.err")")
  if [ "$learn_mode" = true ]; then
    printf '%s' "$out" > "$runner_dir/$1.learn-out"
    printf '%s' "$err" > "$runner_dir/$1.learn-err"
  fi
  if [ "$runner_template" = true ] && [ "$out" = "$template_out" ] && [ "$err" = "$template_err" ]; then
    : > "$runner_dir/$1.quiet"
  fi
}

# Print a learned file's lines with the given prefix.
learn_lines() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    if [ -n "$line" ]; then printf '%s: %s\n' "$1" "$line"; else printf '%s:\n' "$1"; fi
  done < "$2"
}

# Ask before learning, naming how many checkouts agreed and any that differed.
# Only a terminal is asked, so an unattended run never waits.
learn_confirm() {
  local answer summary
  summary="$1 of $(plural "$2" repository repositories) agreed"
  [ "$3" -eq 0 ] || summary="$summary and $3 differed: $4"
  if [ ! -t 0 ]; then
    printf 'mgit: not learned: %s; run it from a terminal to confirm\n' "$summary"
    return 1
  fi
  while true; do
    printf 'mgit learn: %s. Learn this output? [y/N]\n' "$summary"
    if ! IFS= read -r answer; then
      printf 'mgit: not learned: interactive input ended\n'
      return 1
    fi
    case "$answer" in
      y|Y|yes|YES) return 0 ;;
      n|N|no|NO|'') printf 'mgit: not learned: declined\n'; return 1 ;;
      *) printf 'mgit learn: answer y or n\n' >&2 ;;
    esac
  done
}

# After a learning run: when every checkout's normalised output agrees, or more
# than half do, write it as a template once confirmed; else name the checkouts
# that differ from the most common output and write nothing.
learn_verdict() {
  local failed="$1" total=${#repos[@]} i j count best=0 best_count=0 differ="" differing=0 file printed agreed=""
  local -a outputs
  if [ "$failed" -gt 0 ]; then
    printf 'mgit: not learned: %s failed\n' "$(plural "$failed" repository repositories)"
    return 1
  fi
  for i in "${!repos[@]}"; do
    outputs[i]="$(cat "$runner_dir/$i.learn-out")"$'\n\001\n'"$(cat "$runner_dir/$i.learn-err")"
  done
  for i in "${!repos[@]}"; do
    count=0
    for j in "${!repos[@]}"; do
      [ "${outputs[i]}" != "${outputs[j]}" ] || count=$((count + 1))
    done
    [ "$count" -le "$best_count" ] || { best=$i; best_count=$count; }
    [ "$best_count" -lt "$total" ] || break
  done
  for i in "${!repos[@]}"; do
    [ "${outputs[i]}" = "${outputs[best]}" ] && continue
    differ="$differ, ${repo_labels[i]}"
    differing=$((differing + 1))
  done
  if [ $((best_count * 2)) -le "$total" ]; then
    printf 'mgit: not learned: %s of %s differed from the most common output: %s\n' \
      "$differing" "$(plural "$total" repository repositories)" "${differ#, }"
    return 1
  fi
  if [ ! -s "$runner_dir/$best.learn-out" ] && [ ! -s "$runner_dir/$best.learn-err" ]; then
    if [ "$differing" -gt 0 ]; then
      printf 'mgit: not learned: the most common output is empty, which is already quiet; %s of %s differed: %s\n' \
        "$differing" "$(plural "$total" repository repositories)" "${differ#, }"
      return 1
    fi
    printf 'mgit: not learned: no repository printed anything, which is already quiet\n'
    return 0
  fi
  learn_confirm "$best_count" "$total" "$differing" "${differ#, }" || return 1
  [ "$differing" -eq 0 ] || agreed="$best_count of "
  file=$(template_file "${resolved_command[@]}")
  printed=$(printf '%q ' "${resolved_command[@]}")
  printed="${printed% }"
  if ! mkdir -p "${file%/*}" || ! {
    printf '# mgit output template, learned with: mgit learn %s\n' "$printed_cmd"
    printf '# A checkout counts as quiet when this Git command exits 0 and its output,\n'
    printf '# with the checkout'"'"'s own details replaced by {path}, {remote-url},\n'
    printf '# {upstream}, {remote}, {branch} and {repository}, matches the stdout and\n'
    printf '# stderr lines below exactly. Remove it with: mgit learn --forget %s\n' "$printed"
    printf 'command: %s\n' "$printed"
    learn_lines stdout "$runner_dir/$best.learn-out"
    learn_lines stderr "$runner_dir/$best.learn-err"
  } > "$file.tmp" || ! mv "$file.tmp" "$file"; then
    rm -f "$file.tmp"
    printf 'mgit: cannot write %s\n' "$file" >&2
    return 1
  fi
  printf "mgit: learned 'git %s' from %s%s: %s\n" "$printed" "$agreed" "$(plural "$total" repository repositories)" "$file"
}

learn_list() {
  local file line command
  for file in "$(template_dir)"/*.template; do
    [ -f "$file" ] || continue
    command=""
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in 'command: '*) command="${line#command: }"; break ;; esac
    done < "$file"
    printf 'git %s\t%s\n' "$command" "$file"
  done
}

learn_forget() {
  local file printed
  resolve_git_aliases "$@"
  file=$(template_file "${resolved_command[@]}")
  printed=$(printf '%q ' "${resolved_command[@]}")
  printed="${printed% }"
  [ -f "$file" ] || { printf "mgit: no template for 'git %s'\n" "$printed" >&2; return 1; }
  rm -f "$file" || return 1
  printf "mgit: forgot 'git %s': %s\n" "$printed" "$file"
}

# Today's dispatch: every checkout in turn, streaming, with a header each.
dispatch_streaming() {
  local i d label failed=false
  for i in "${!repos[@]}"; do
    d="${repos[$i]}"
    label="${repo_labels[$i]}"
    if [ "$runner_raw" = true ]; then
      printf '%s%s%s%s: %s\n' "$BOLD" "$YELLOW" "$label" "$CLEAR" "$printed_cmd"
      ( cd "$d" && "${runner_command[@]}" ) || failed=true
    else
      printf '%s%s%s%s: git %s\n' "$BOLD" "$YELLOW" "$label" "$CLEAR" "$printed_cmd"
      ( cd "$d" && git "${runner_command[@]}" ) || failed=true
    fi
  done
  [ "$failed" = false ]
}

file_json_string() {
  local content
  content=$(cat "$1"; printf x)
  json_string "${content%x}"
}

# Captured dispatch: run every checkout in the pool, then print in selection
# order only checkouts with output or a failure, and close with the counts.
dispatch_captured() {
  local i label status quiet shown=0 quiets=0 failed=0 failures="" first=true header path result=0
  if [ "$runner_raw" = true ]; then header="$printed_cmd"; else header="git $printed_cmd"; fi
  runner_start || return 1
  runner_run dispatch_worker
  [ "$runner_json" = false ] ||
    printf '{"tool":"mgit","command":%s,"version":%s,"repositories":[' \
      "$(json_string "$header")" "$(json_string "$MGIT_VERSION")"
  for i in "${!repos[@]}"; do
    label="${repo_labels[$i]}"
    status=$(runner_status "$i")
    quiet=false
    if [ "$status" -ne 0 ]; then
      failed=$((failed + 1))
      failures="$failures, $label (exit $status)"
    elif [ -f "$runner_dir/$i.quiet" ] ||
      { [ ! -s "$runner_dir/$i.out" ] && [ ! -s "$runner_dir/$i.err" ]; }; then
      quiet=true
      quiets=$((quiets + 1))
    else
      shown=$((shown + 1))
    fi
    if [ "$runner_json" = true ]; then
      [ "$first" = true ] || printf ','
      first=false
      capture_dir path "${repos[$i]}" || path="${repos[$i]}"
      printf '{"label":%s,"path":%s,"exit":%s,"quiet":%s,"stdout":%s,"stderr":%s}' \
        "$(json_string "$label")" "$(json_string "$path")" "$status" "$quiet" \
        "$(file_json_string "$runner_dir/$i.out")" "$(file_json_string "$runner_dir/$i.err")"
      continue
    fi
    [ "$quiet" = false ] || continue
    printf '%s%s%s%s: %s\n' "$BOLD" "$YELLOW" "$label" "$CLEAR" "$header"
    cat "$runner_dir/$i.out"
    cat "$runner_dir/$i.err" >&2
  done
  if [ "$runner_json" = true ]; then
    printf '],"summary":{"repositories":%s,"quiet":%s,"output":%s,"failed":%s}}\n' \
      "${#repos[@]}" "$quiets" "$shown" "$failed"
  else
    printf 'mgit: %s: %s quiet, %s with output, %s failed%s\n' \
      "$(plural "${#repos[@]}" repository repositories)" "$quiets" "$shown" "$failed" \
      "${failures:+: ${failures#, }}"
  fi
  [ "$failed" -eq 0 ] || result=1
  [ "$learn_mode" = false ] || learn_verdict "$failed" || result=1
  runner_cleanup
  return "$result"
}

# Chains. `mgit chain` runs Git subcommands in order in each checkout. The
# steps live in one flat word list, chain_words, with each step's first index
# and length in chain_starts and chain_lengths, since Bash 3.2 has no nested
# arrays; chain_texts holds each step as printed.
chain_words=()
chain_starts=()
chain_lengths=()
chain_texts=()
chain_recipe_label=""

# Split the words at each literal --then into steps. Returns 1 when a step
# would be empty: a leading, trailing or doubled --then, or no words at all.
chain_split() {
  local word count=0
  chain_words=(); chain_starts=(); chain_lengths=(); chain_texts=()
  for word in "$@" --then; do
    if [ "$word" != --then ]; then
      chain_words+=("$word")
      count=$((count + 1))
      continue
    fi
    [ "$count" -gt 0 ] || return 1
    chain_starts+=($((${#chain_words[@]} - count)))
    chain_lengths+=("$count")
    chain_texts+=("git$(printf ' %q' "${chain_words[@]:${#chain_words[@]} - count}")")
    count=0
  done
}

# Split $1 into split_words as a shell splits plain words: blanks separate
# words, single quotes keep text literally, double quotes keep text with \"
# and \\ escaped, and a backslash elsewhere keeps the next character. There is
# no expansion of any kind. Returns 1 on an unterminated quote.
split_recipe() {
  local text="$1" word="" have=false quote="" c next i=0
  split_words=()
  while [ "$i" -lt ${#text} ]; do
    c="${text:i:1}"
    next="${text:i+1:1}"
    i=$((i + 1))
    if [ "$quote" = "'" ]; then
      if [ "$c" = "'" ]; then quote=""; else word="$word$c"; fi
    elif [ "$quote" = '"' ]; then
      case "$c" in
        '"') quote="" ;;
        \\)
          case "$next" in
            '"'|\\) word="$word$next"; i=$((i + 1)) ;;
            *) word="$word$c" ;;
          esac ;;
        *) word="$word$c" ;;
      esac
    else
      case "$c" in
        ' '|$'\t'|$'\n')
          [ "$have" = false ] || split_words+=("$word")
          word=""; have=false ;;
        "'"|'"') quote="$c"; have=true ;;
        \\) word="$word$next"; i=$((i + 1)); have=true ;;
        *) word="$word$c"; have=true ;;
      esac
    fi
  done
  [ -z "$quote" ] || return 1
  [ "$have" = false ] || split_words+=("$word")
}

# Set chain_recipe_value to recipe $1, read from the Git configuration visible
# where mgit runs. Returns 1 when $1 is not a valid key name or has no value.
chain_recipe() {
  case "$1" in
    ''|[!A-Za-z]*|*[!A-Za-z0-9-]*) return 1 ;;
  esac
  chain_recipe_value=$(git config --get "mgit.chain.$1" 2>/dev/null)
}

# Set the steps from the words after `chain`: a lone word naming a recipe runs
# that recipe, and otherwise the words are the steps themselves.
chain_parse() {
  [ $# -gt 0 ] || { usage_error_for chain_usage 'chain requires a Git command or a recipe name'; return; }
  case "$1" in
    -h|--help)
      [ $# -eq 1 ] || { usage_error_for chain_usage "chain: unexpected argument: $2"; return; }
      chain_usage
      exit 0 ;;
  esac
  if [ $# -eq 1 ] && chain_recipe "$1"; then
    chain_recipe_label="$1"
    split_recipe "$chain_recipe_value" ||
      { printf 'mgit: recipe %s: unterminated quote in mgit.chain.%s\n' "$1" "$1" >&2; return 1; }
    chain_split "${split_words[@]+"${split_words[@]}"}" ||
      { printf 'mgit: recipe %s: every step needs a Git command\n' "$1" >&2; return 1; }
    return 0
  fi
  chain_split "$@" || usage_error_for chain_usage 'chain: every step needs a Git command on each side of --then'
}

# Run every step in checkout $1 in turn, keeping each step's output and exit
# status, and stop at the first step that fails.
chain_worker() {
  local s=0 status
  cd "${repos[$1]}" || return 1
  while [ "$s" -lt ${#chain_starts[@]} ]; do
    status=0
    git "${chain_words[@]:${chain_starts[s]}:${chain_lengths[s]}}" \
      > "$runner_dir/$1.$s.out" 2> "$runner_dir/$1.$s.err" || status=$?
    printf '%s\n' "$status" > "$runner_dir/$1.$s.rc"
    [ "$status" -eq 0 ] || return "$status"
    s=$((s + 1))
  done
}

chain_completed=0
chain_stopped=0
chain_unstarted=0
chain_failures=""

# Count checkout label $1, whose chain stopped at step index $2 with status $3;
# a stop at the step count means every step completed. Sets chain_outcome.
chain_count() {
  if [ "$2" -ge ${#chain_starts[@]} ]; then
    chain_outcome=completed
    chain_completed=$((chain_completed + 1))
    return
  fi
  if [ "$2" -eq 0 ]; then
    chain_outcome='failed-to-start'
    chain_unstarted=$((chain_unstarted + 1))
  else
    chain_outcome=stopped
    chain_stopped=$((chain_stopped + 1))
  fi
  chain_failures="$chain_failures, $1 (step $(($2 + 1)), exit $3)"
}

chain_tally() {
  printf 'mgit chain: %s: %s completed, %s stopped, %s failed to start%s\n' \
    "$(plural "${#repos[@]}" repository repositories)" "$chain_completed" "$chain_stopped" \
    "$chain_unstarted" "${chain_failures:+: ${chain_failures#, }}"
}

# Set chain_stop and chain_stop_status for checkout $1 from its step files.
chain_result() {
  local s=0 status
  chain_stop=${#chain_starts[@]}
  chain_stop_status=0
  while [ "$s" -lt ${#chain_starts[@]} ]; do
    status=""
    [ ! -f "$runner_dir/$1.$s.rc" ] || IFS= read -r status < "$runner_dir/$1.$s.rc" || true
    if [ "${status:-none}" != 0 ]; then
      chain_stop=$s
      chain_stop_status="${status:-$(runner_status "$1")}"
      return
    fi
    s=$((s + 1))
  done
}

# Captured chain: run every checkout's chain in the pool, then print one block
# per checkout in selection order and close with the tally.
chain_captured() {
  local i s label path state first=true step_first
  runner_start || return 1
  runner_run chain_worker
  if [ "$runner_json" = true ]; then
    printf '{"tool":"mgit","command":"chain","version":%s,"recipe":' "$(json_string "$MGIT_VERSION")"
    if [ -n "$chain_recipe_label" ]; then json_string "$chain_recipe_label"; else printf null; fi
    printf ',"steps":['
    for s in "${!chain_texts[@]}"; do
      [ "$s" -eq 0 ] || printf ','
      json_string "${chain_texts[s]}"
    done
    printf '],"repositories":['
  fi
  for i in "${!repos[@]}"; do
    label="${repo_labels[$i]}"
    chain_result "$i"
    chain_count "$label" "$chain_stop" "$chain_stop_status"
    if [ "$runner_json" = true ]; then
      [ "$first" = true ] || printf ','
      first=false
      capture_dir path "${repos[$i]}" || path="${repos[$i]}"
      printf '{"label":%s,"path":%s,"outcome":"%s","steps":[' \
        "$(json_string "$label")" "$(json_string "$path")" "$chain_outcome"
      step_first=true
      for s in "${!chain_texts[@]}"; do
        [ "$step_first" = true ] || printf ','
        step_first=false
        if [ "$s" -gt "$chain_stop" ] || [ ! -f "$runner_dir/$i.$s.rc" ]; then
          printf '{"command":%s,"run":false}' "$(json_string "${chain_texts[s]}")"
        else
          printf '{"command":%s,"run":true,"exit":%s,"stdout":%s,"stderr":%s}' \
            "$(json_string "${chain_texts[s]}")" "$(runner_step_status "$i" "$s")" \
            "$(file_json_string "$runner_dir/$i.$s.out")" "$(file_json_string "$runner_dir/$i.$s.err")"
        fi
      done
      printf ']}'
      continue
    fi
    printf '%s%s%s%s\n' "$BOLD" "$YELLOW" "$label" "$CLEAR"
    cat "$runner_dir/$i.err" >&2
    for s in "${!chain_texts[@]}"; do
      if [ "$s" -lt "$chain_stop" ]; then state=ok
      elif [ "$s" -eq "$chain_stop" ]; then state="failed (exit $chain_stop_status)"
      else state="not run"
      fi
      printf '  %s %s: %s\n' "$((s + 1))" "$state" "${chain_texts[s]}"
      [ -f "$runner_dir/$i.$s.rc" ] || continue
      cat "$runner_dir/$i.$s.out"
      cat "$runner_dir/$i.$s.err" >&2
    done
  done
  if [ "$runner_json" = true ]; then
    printf '],"summary":{"repositories":%s,"completed":%s,"stopped":%s,"failed_to_start":%s}}\n' \
      "${#repos[@]}" "$chain_completed" "$chain_stopped" "$chain_unstarted"
  else
    chain_tally
  fi
  runner_cleanup
  [ $((chain_stopped + chain_unstarted)) -eq 0 ]
}

runner_step_status() {
  local status=""
  IFS= read -r status < "$runner_dir/$1.$2.rc" || true
  printf '%s' "${status:-1}"
}

# Streaming chain: one checkout at a time, each step's header and output as it
# runs, then the same tally.
chain_streaming() {
  local i s d label stop status
  for i in "${!repos[@]}"; do
    d="${repos[$i]}"
    label="${repo_labels[$i]}"
    stop=${#chain_starts[@]}
    status=0
    for s in "${!chain_texts[@]}"; do
      printf '%s%s%s%s: %s\n' "$BOLD" "$YELLOW" "$label" "$CLEAR" "${chain_texts[s]}"
      ( cd "$d" && git "${chain_words[@]:${chain_starts[s]}:${chain_lengths[s]}}" ) || {
        status=$?
        stop=$s
        break
      }
    done
    chain_count "$label" "$stop" "$status"
  done
  chain_tally
  [ $((chain_stopped + chain_unstarted)) -eq 0 ]
}

selected_workspace_dirs=()
selected_repo_dirs=()
selected_local_repo_dirs=()

selected_path_seen() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

# Repositories are identified by physical path. Two local members reaching the
# same repository are a manifest error; an external member may also be reached
# from another workspace in the recursive set, so it is selected once.
select_workspace() {
  local base="$1" requested_group="$2" canonical group destination actual i pass scope
  local groups=() kinds=() paths=() scopes=()
  capture_dir canonical "$base" || {
    printf 'mgit: cannot read workspace directory: %s\n' "$base" >&2
    return 1
  }
  selected_path_seen "$canonical" "${selected_workspace_dirs[@]+"${selected_workspace_dirs[@]}"}" && {
    printf 'mgit: duplicate or cyclic workspace path: %s\n' "$canonical" >&2
    return 1
  }
  selected_workspace_dirs+=("$canonical")
  parse_workspace "$canonical/$MGIT_MANIFEST" || return 1
  group="$requested_group"
  [ -n "$group" ] || group="$workspace_default"
  workspace_group_known "$group" || {
    printf 'mgit: %s: unknown workspace group: %s\n' "$canonical/$MGIT_MANIFEST" "$group" >&2
    return 1
  }
  groups=("${workspace_record_groups[@]+"${workspace_record_groups[@]}"}")
  kinds=("${workspace_record_kinds[@]+"${workspace_record_kinds[@]}"}")
  paths=("${workspace_record_paths[@]+"${workspace_record_paths[@]}"}")
  scopes=("${workspace_record_scopes[@]+"${workspace_record_scopes[@]}"}")
  for pass in local external; do
    for i in "${!paths[@]}"; do
      [ "${groups[$i]}" = "$group" ] || continue
      scope="${scopes[$i]}"
      [ "$scope" != legacy ] || scope=external
      [ "$scope" = "$pass" ] || continue
      destination=$(resolve_path "${paths[$i]}" "$canonical")
      case "${kinds[$i]}" in
        workspace)
          if [ ! -d "$destination" ] || [ -L "$destination" ]; then
            printf 'mgit: unsafe or missing workspace path: %s\n' "$destination" >&2
            return 1
          fi
          [ -f "$destination/$MGIT_MANIFEST" ] || {
            printf 'mgit: workspace manifest not found: %s\n' "$destination/$MGIT_MANIFEST" >&2
            return 1
          }
          select_workspace "$destination" "" || return 1
          ;;
        repository)
          if [ ! -d "$destination" ] || [ -L "$destination" ]; then
            if [ "$scope" = local ]; then
              printf 'mgit: unsafe or missing repository path: %s\n' "$destination" >&2
            else
              printf 'mgit: unsafe or missing external repository path: %s\n' "$destination" >&2
            fi
            return 1
          fi
          capture_dir destination "$destination" || return 1
          actual=$(repo_type "$destination")
          [ "$actual" != unknown ] || {
            printf 'mgit: workspace member is not a repository: %s\n' "$destination" >&2
            return 1
          }
          if [ "${scopes[$i]}" = external ] &&
            workspace_external_inside "$canonical" "$destination" mgit; then
            return 1
          fi
          if [ "$scope" = local ]; then
            selected_path_seen "$destination" "${selected_local_repo_dirs[@]+"${selected_local_repo_dirs[@]}"}" && {
              printf 'mgit: duplicate repository path in workspace selection: %s\n' "$destination" >&2
              return 1
            }
            selected_local_repo_dirs+=("$destination")
          fi
          selected_path_seen "$destination" "${selected_repo_dirs[@]+"${selected_repo_dirs[@]}"}" ||
            selected_repo_dirs+=("$destination")
          ;;
      esac
    done
  done
}

# Resolve one named KI territory, the registered estate or the territory
# Capitals through ki, keeping the producer's order. The NUL stream is captured
# before parsing so a resolver failure cannot leave a partial repository set
# for a command to run against.
select_ki_roots() {
  local name="$1" selector="$2" temporary root canonical actual prefix
  local producer_args=(territory roots --null)
  local failed=false
  command -v ki >/dev/null 2>&1 || {
    printf 'mgit: %s requires ki on PATH\n' "$selector" >&2
    return 1
  }
  temporary=$(mktemp) || {
    printf 'mgit: cannot create temporary file for territory roots\n' >&2
    return 1
  }
  if [ "$selector" = --estate ] || [ "$selector" = --principals ]; then
    producer_args+=("$selector")
  else
    producer_args+=(--territory "$name")
  fi
  for prefix in "${filters[@]+"${filters[@]}"}"; do producer_args+=(--filter "$prefix"); done
  if ! ki "${producer_args[@]}" > "$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  selected_repo_dirs=()
  root=""
  while IFS= read -r -d '' root; do
    [ -n "$root" ] || {
      printf 'mgit: ki territory roots returned an empty repository path\n' >&2
      failed=true
      break
    }
    case "$root" in
      /*) ;;
      *)
        printf 'mgit: ki territory roots returned a non-absolute path: %s\n' "$root" >&2
        failed=true
        break
        ;;
    esac
    if [ ! -d "$root" ] || [ -L "$root" ]; then
      printf 'mgit: ki territory roots returned an unsafe or missing repository: %s\n' "$root" >&2
      failed=true
      break
    fi
    capture_dir canonical "$root" || {
      failed=true
      break
    }
    actual=$(repo_type "$canonical")
    [ "$actual" != unknown ] || {
      printf 'mgit: ki territory roots returned a non-repository: %s\n' "$root" >&2
      failed=true
      break
    }
    selected_path_seen "$canonical" "${selected_repo_dirs[@]+"${selected_repo_dirs[@]}"}" && {
      printf 'mgit: ki territory roots returned a duplicate repository: %s\n' "$root" >&2
      failed=true
      break
    }
    selected_repo_dirs+=("$canonical")
  done < "$temporary"
  if [ -n "$root" ]; then
    printf 'mgit: ki territory roots returned incomplete NUL output\n' >&2
    failed=true
  fi
  rm -f "$temporary"
  [ "$failed" = false ] || return 1
  [ ${#selected_repo_dirs[@]} -gt 0 ] || {
    printf 'mgit: ki territory roots returned no repositories: %s\n' "$name" >&2
    return 1
  }
}

# Match the logical repository directory basename literally before expansion.
filter_match() {
  local path="${1%/}" prefix
  [ "$path" != . ] || path="$cwd_canon"
  path="${path##*/}"
  for prefix in "${filters[@]}"; do
    case "$path" in "$prefix"*) return 0 ;; esac
  done
  return 1
}

follow_symlinks=false
discovery_option=false
bare=false
git_mode=false
learn_mode=false
all_worktrees=false
read_config=true
filters=()
territory_handle=""
ki_selector=""
show_help=false
show_version=false
jobs_option=false
runner_verbose=false
runner_json=false

split_options top tj '--territory --filter --jobs' "$@"
set -- "${split_args[@]+"${split_args[@]}"}"
while [ $# -gt 0 ]; do
  case "$1" in
    -P|--physical)        follow_symlinks=false; discovery_option=true ;;
    -L|--follow-symlinks) follow_symlinks=true; discovery_option=true ;;
    -B|--bypass)          git_mode=true ;;
    -R|--raw)             bare=true ;;
    --learn)              learn_mode=true ;;
    -G|--git)
      usage_error "$1 has been removed; use -B/--bypass to run a Git command"
      exit $? ;;
    --bare)
      usage_error "$1 has been removed; use -R/--raw to run a command directly"
      exit $? ;;
    -W|--all-worktrees)   all_worktrees=true ;;
    -I|--ignore)          read_config=false ;;
    -a|--agora)
      usage_error 'Agora selectors are retired; use -t/--territory HANDLE (no aliases); preview saved-location migration with register --dry-run'
      exit $? ;;
    --repo)
      usage_error '--repo is only supported by register add/rm; explicit repository scope cannot be combined with territory, estate or principals'
      exit $? ;;
    -t|--territory)
      [ $# -ge 2 ] || { usage_error "$1 requires a territory name"; exit $?; }
      [ -z "$ki_selector" ] || { usage_error '--territory, --estate and --principals cannot be combined or repeated'; exit $?; }
      ki_selector=--territory
      [ -n "$2" ] || { usage_error "--territory requires a nonempty handle"; exit $?; }
      territory_handle="$2"; shift ;;
    --estate)
      [ -z "$ki_selector" ] || { usage_error '--territory, --estate and --principals cannot be combined or repeated'; exit $?; }
      ki_selector=--estate
      territory_handle=estate ;;
    --principals)
      [ -z "$ki_selector" ] || { usage_error '--territory, --estate and --principals cannot be combined or repeated'; exit $?; }
      ki_selector=--principals
      territory_handle=principals ;;
    -f)
      usage_error "$1 has been removed; use --filter to select repositories"
      exit $? ;;
    --filter)
      [ $# -ge 2 ] || { usage_error "$1 requires a literal prefix"; exit $?; }
      [ -n "$2" ] || { usage_error "--filter requires a nonempty literal prefix"; exit $?; }
      filters+=("$2"); shift ;;
    -j|--jobs)
      [ $# -ge 2 ] || { usage_error "$1 requires a number of jobs"; exit $?; }
      case "$2" in
        ''|*[!0-9]*|0*) usage_error "--jobs requires a positive whole number: $2"; exit $? ;;
      esac
      runner_jobs="$2"; jobs_option=true; shift ;;
    -v|--verbose)         runner_verbose=true ;;
    --json)               runner_json=true ;;
    -h|--help)            show_help=true ;;
    -V|--version)         show_version=true ;;
    --)                   shift; break ;;
    -*)                   usage_error "unknown option: $1"; exit $? ;;
    *)                    break ;;
  esac
  shift
done

[ "$show_version" = false ] || { printf 'mgit %s\n' "$MGIT_VERSION"; exit 0; }

# With --bypass every argument goes to Git, so no command name is owned by mgit.
owned_command="${1:-}"
if [ "$git_mode" = true ]; then
  [ "$bare" = false ] || { usage_error "--bypass cannot be combined with --raw"; exit $?; }
  [ "$show_help" = false ] || { usage; exit 0; }
  [ $# -gt 0 ] || { usage_error '--bypass requires a Git command'; exit $?; }
  owned_command=git
fi

if [ "$show_help" = true ]; then
  help_command "$@"
  exit $?
fi

if [ "$owned_command" = help ]; then
  shift
  help_command "$@"
  exit $?
fi

reject_selector_for() {
  local command="$1" option="$2"
  usage_error "$option cannot be used with $command"
}
is_mgit_command() {
  case "$1" in
    register|repair|doctor|diag|sync|overview|structure|worktree|chain|learn|completion|help|config) return 0 ;;
  esac
  return 1
}
reject_runner_options_for() {
  [ "$jobs_option" = false ] || { reject_selector_for "$1" --jobs; return; }
  [ "$runner_verbose" = false ] || { reject_selector_for "$1" --verbose; return; }
  [ "$runner_json" = false ] || { reject_selector_for "$1" --json; return; }
}
# `learn --list` and `learn --forget` only read or change templates; `learn
# COMMAND` and `--learn COMMAND` run a Git command as usual and learn from it.
learn_reject_selectors() {
  [ "$discovery_option" = false ] || { reject_selector_for "$1" 'discovery traversal options'; return; }
  [ "$read_config" = true ] || { reject_selector_for "$1" --ignore; return; }
  [ ${#filters[@]} -eq 0 ] || { reject_selector_for "$1" --filter; return; }
  [ "$all_worktrees" = false ] || { reject_selector_for "$1" --all-worktrees; return; }
  [ -z "$ki_selector" ] || { reject_selector_for "$1" "$ki_selector"; return; }
  [ "$bare" = false ] || { reject_selector_for "$1" --raw; return; }
  [ "$learn_mode" = false ] || { reject_selector_for "$1" --learn; return; }
  reject_runner_options_for "$1"
}
if [ "$owned_command" = learn ]; then
  shift
  case "${1:-}" in
    -h|--help)
      [ $# -eq 1 ] || { usage_error_for learn_usage "learn: unexpected argument: $2"; exit $?; }
      learn_usage
      exit 0 ;;
    --list)
      learn_reject_selectors 'learn --list' || exit $?
      [ $# -eq 1 ] || { usage_error_for learn_usage "learn --list: unexpected argument: $2"; exit $?; }
      learn_list
      exit $? ;;
    --forget)
      learn_reject_selectors 'learn --forget' || exit $?
      shift
      [ $# -gt 0 ] || { usage_error_for learn_usage 'learn --forget requires a command'; exit $?; }
      learn_forget "$@"
      exit $? ;;
  esac
  learn_mode=true
  owned_command="${1:-}"
fi
if [ "$learn_mode" = true ]; then
  [ $# -gt 0 ] || { usage_error_for learn_usage 'learn requires a command'; exit $?; }
  [ "$bare" = false ] || { usage_error_for learn_usage '--learn cannot be combined with --raw'; exit $?; }
  [ "$runner_verbose" = false ] || { usage_error_for learn_usage '--learn cannot be combined with --verbose'; exit $?; }
  [ "$runner_json" = false ] || { usage_error_for learn_usage '--learn cannot be combined with --json'; exit $?; }
  if is_mgit_command "$owned_command"; then
    usage_error_for learn_usage "learn: $owned_command is an mgit command; use -B/--bypass to learn the Git command"
    exit $?
  fi
fi
# A lone word naming a chain recipe runs it as `chain NAME`, ahead of Git
# pass-through but never in place of an mgit command.
if [ $# -eq 1 ] && [ "$git_mode" = false ] && [ "$bare" = false ] && [ "$learn_mode" = false ] &&
  ! is_mgit_command "$1" && chain_recipe "$1"; then
  set -- chain "$1"
  owned_command=chain
fi
case "$owned_command" in
  register|repair|doctor|diag|completion)
    command_name="${1:-}"
    [ "$discovery_option" = false ] || { reject_selector_for "$command_name" 'discovery traversal options'; exit $?; }
    [ "$read_config" = true ] || { reject_selector_for "$command_name" --ignore; exit $?; }
    [ ${#filters[@]} -eq 0 ] || { reject_selector_for "$command_name" --filter; exit $?; }
    [ "$all_worktrees" = false ] || { reject_selector_for "$command_name" --all-worktrees; exit $?; }
    [ "$bare" = false ] || { reject_selector_for "$command_name" --raw; exit $?; }
    reject_runner_options_for "$command_name" || exit $?
    if [ "$command_name" != register ] || [ "$ki_selector" != --territory ]; then
      [ -z "$ki_selector" ] || { reject_selector_for "$command_name" "$ki_selector"; exit $?; }
    fi
    ;;
  sync|overview|structure|worktree)
    command_name="${1:-}"
    [ "$bare" = false ] || { reject_selector_for "$command_name" --raw; exit $?; }
    case "$command_name" in
      overview) ;;
      sync) [ "$runner_json" = false ] || { reject_selector_for sync --json; exit $?; } ;;
      *) reject_runner_options_for "$command_name" || exit $? ;;
    esac
    if [ "$command_name" != sync ] && [ "$command_name" != overview ]; then
      [ "$all_worktrees" = false ] || { reject_selector_for "$command_name" --all-worktrees; exit $?; }
      [ -z "$ki_selector" ] || { reject_selector_for "$command_name" "$ki_selector"; exit $?; }
    fi
    ;;
  chain)
    [ "$bare" = false ] || { reject_selector_for chain --raw; exit $?; }
    if [ "$runner_verbose" = true ] && [ "$runner_json" = true ]; then
      usage_error '--verbose and --json cannot be combined'
      exit $?
    fi
    chain_parse "${@:2}" || exit $?
    ;;
  '')
    [ "$bare" = false ] || { usage_error "--raw requires a command"; exit $?; }
    reject_runner_options_for listing || exit $?
    ;;
  *)
    if [ "$runner_verbose" = true ] && [ "$runner_json" = true ]; then
      usage_error '--verbose and --json cannot be combined'
      exit $?
    fi
    ;;
esac

if [ "$owned_command" = completion ]; then
  shift
  if [ "$show_help" = true ]; then completion_command "$@" --help; else completion_command "$@"; fi
  exit $?
fi

if [ "$owned_command" = repair ]; then
  [ -z "$territory_handle" ] || { usage_error "$ki_selector cannot be used with repair"; exit $?; }
  shift
  if [ "$show_help" = true ]; then repair_command "$@" --help; else repair_command "$@"; fi
  exit $?
fi

if [ "$owned_command" = config ]; then
  usage_error "command 'config' removed; use mgit repair"
  exit $?
fi

if [ "$owned_command" = doctor ]; then
  shift
  doctor_command "$@"
  exit $?
fi

if [ "$owned_command" = diag ]; then
  shift
  diag_command "$@"
  exit $?
fi

# `register` is self-contained (it scans the filesystem), so handle it before
# building the repo set.
if [ "$owned_command" = register ]; then
  [ "$ki_selector" = --territory ] || [ -z "$ki_selector" ] || { usage_error "$ki_selector cannot be used with register"; exit $?; }
  [ "$ki_selector" != --territory ] || [ -n "$territory_handle" ] || { usage_error 'register: territory name must not be empty'; exit $?; }
  register_action=refresh
  register_dry_run=false
  register_change_specs=()
  if [ "$ki_selector" = --territory ]; then
    register_action=add
    register_change_specs+=("territory:$territory_handle")
  fi
  register_help="$show_help"
  shift
  case "${1:-}" in
    add|rm)
      [ "$ki_selector" != --territory ] || [ "$1" = add ] || { usage_error_for register_usage 'register: --territory cannot be combined with rm'; exit $?; }
      register_action="$1"
      shift
      ;;
  esac
  split_options sub t '--territory --repo' "$@"
  set -- "${split_args[@]+"${split_args[@]}"}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) register_dry_run=true ;;
      -a|--agora)
        usage_error_for register_usage 'Agora selectors are retired; use --territory HANDLE and preview with --dry-run'; exit $? ;;
      -t|--territory)
        [ $# -ge 2 ] || { usage_error_for register_usage "$1 requires territory name"; exit $?; }
        [ -n "$2" ] || { usage_error_for register_usage 'register: territory name must not be empty'; exit $?; }
        [ "$register_action" != refresh ] || register_action=add
        register_change_specs+=("territory:$2")
        shift
        ;;
      --repo)
        [ $# -ge 2 ] || { usage_error_for register_usage '--repo requires path'; exit $?; }
        [ "$register_action" != refresh ] || register_action=add
        spec=$(register_repo_spec "$2" "$register_action") || exit 1
        register_change_specs+=("$spec")
        shift
        ;;
      -h|--help) register_help=true ;;
      *) usage_error_for register_usage "register: unexpected argument: $1"; exit $? ;;
    esac
    # shellcheck disable=SC2317  # reachable once register grows an option that doesn't exit
    shift
  done
  [ "$register_help" = false ] || { register_usage; exit 0; }
  if [ "$register_action" != refresh ] && [ ${#register_change_specs[@]} -eq 0 ]; then
    usage_error_for register_usage "register $register_action requires --territory or --repo"
    exit $?
  fi
  if [ "$register_action" != refresh ] && [ "$(repo_type .)" != unknown ]; then
    usage_error_for register_usage 'register locations require a workspace directory'
    exit $?
  fi
  [ "$register_dry_run" = true ] || chezmoi_init
  register_preflight_tree "." || exit 1
  if register_tree "."; then
    exit 0
  else
    status=$?
    if [ "$status" -eq 1 ]; then
      printf 'mgit register: no git repos found under %s\n' "$(pwd)" >&2
    fi
    exit "$status"
  fi
fi

repos=()
cwd_manifest_kind=""

if [ -z "$territory_handle" ] && [ "$read_config" = true ] && [ -f "./$MGIT_MANIFEST" ]; then
  cwd_manifest_kind=$(manifest_kind "./$MGIT_MANIFEST") || exit 1
fi

if [ -n "$territory_handle" ]; then
  [ "$read_config" = true ] || { usage_error "$ki_selector cannot be combined with --ignore"; exit $?; }
  [ "$discovery_option" = false ] || {
    usage_error "$ki_selector cannot be combined with discovery traversal options"
    exit $?
  }
  case "$owned_command" in
    structure|worktree)
      usage_error "$ki_selector cannot be used with ${1}"
      exit $?
      ;;
  esac
fi

# Base set: a direct cwd workspace selects an ordered group and recursively
# expands child workspaces. There is deliberately no parent-config traversal.
if [ -n "$territory_handle" ]; then
  select_ki_roots "$territory_handle" "$ki_selector" || exit 1
  repos=("${selected_repo_dirs[@]+"${selected_repo_dirs[@]}"}")
elif [ "$read_config" = true ] && [ "$cwd_manifest_kind" = workspace ]; then
  select_workspace "." "" || exit 1
  repos=("${selected_repo_dirs[@]+"${selected_repo_dirs[@]}"}")
else
  # Include the current directory itself when it is a repository.  In
  # particular, a bare store has no nested .git marker for `find` to discover.
  [ "$(repo_type ".")" != unknown ] && repos+=(".")
  if [ "$follow_symlinks" = true ]; then
    found=$(
      find -L . -name .git 2>/dev/null | sed -e 's:/\.git$::' -e 's:^\./::'
      find -L . -type d -name '*.git' -print 2>/dev/null
    )
  else
    found=$(
      find . -name .git 2>/dev/null | sed -e 's:/\.git$::' -e 's:^\./::'
      find . -type d -name '*.git' -print 2>/dev/null
    )
  fi
  found=$(printf '%s\n' "$found" | sed -e 's:^\./::' | sort -u)

  # Sorted order means any parent repository appears before its children, so a
  # prefix check against already-kept repos drops the nested ones.  The .git
  # marker candidates and `*.git` candidates are both verified by Git here.
  while IFS= read -r r; do
    [ -z "$r" ] && continue
    [ "$(repo_type "$r")" != unknown ] || continue
    is_linked_checkout "$r" && continue
    nested=false
    for parent in "${repos[@]+"${repos[@]}"}"; do
      case "$r" in
        "$parent"/*) nested=true; break ;;
      esac
    done
    [ "$nested" = false ] && repos+=("$r")
  done <<< "$found"
fi

# Walk repository-owned symlink metadata. Symlink entries pull in the repository
# containing each target, transitively, with cycle/duplicate guards.
final=()
seen=()

is_seen() {
  local needle="$1" x
  for x in "${seen[@]+"${seen[@]}"}"; do
    [ "$x" = "$needle" ] && return 0
  done
  return 1
}

capture_dir cwd_canon "."
# Path of canonical dir $1 relative to the cwd (e.g. hnr/kit-hnr, ../other/repo).
disp() { relpath "$cwd_canon" "$1"; }

queue=()  # canonical dirs whose .mgit.toml still needs walking

# Seed from the ordered base set.
for r in "${repos[@]+"${repos[@]}"}"; do
  capture_dir c "$r"
  if [ -z "$c" ]; then
    printf 'mgit: skipping (not a directory): %s\n' "$r" >&2
    continue
  fi
  is_seen "$c" && continue
  seen+=("$c"); queue+=("$c")
  [ "$(repo_type "$c")" != unknown ] && { capture_path disp "$c"; final+=("$captured_path"); }
done

if [ -z "$territory_handle" ]; then
  qi=0
  while [ $qi -lt ${#queue[@]} ]; do
    repo="${queue[$qi]}"; qi=$((qi + 1))
    records=$(parse_mgit "$repo") || exit 1
    while IFS=$'\t' read -r kind _ b; do
      case "$kind" in
        L)
          [ -z "$b" ] && continue
          add=$(repo_of "$(resolve_path "$b" "$repo")")
          if [ -z "$add" ]; then
            printf 'mgit: %s: symlink target not inside a git repo: %s\n' \
              "$repo/$MGIT_MANIFEST" "$b" >&2
            continue
          fi
          is_seen "$add" && continue
          seen+=("$add"); queue+=("$add"); capture_path disp "$add"; final+=("$captured_path")  # target is a repo
          ;;
      esac
    done <<< "$records"
  done
fi

repo_units=("${final[@]+"${final[@]}"}")

# Default selection filters logical repository basenames before checkout expansion.
# Explicit KI selections have already been filtered by the producer.
if [ -z "$ki_selector" ] && [ ${#filters[@]} -gt 0 ]; then
  kept=()
  for r in "${repo_units[@]+"${repo_units[@]}"}"; do
    filter_match "$r" && kept+=("$r")
  done
  repo_units=("${kept[@]+"${kept[@]}"}")
  [ ${#repo_units[@]} -gt 0 ] || { printf 'mgit: filters matched no repositories\n' >&2; exit 1; }
fi

repos=()
repo_labels=()
repo_roots=()

# Keep execution paths separate from labels for runtime-owned worktrees.
add_checkout() {
  local root="$1" checkout="$2" label branch
  capture_path disp "$checkout"; label="$captured_path"
  case "$checkout" in
    "$root") ;;
    "$root"/.git/*|"$root"/.bare/*)
      branch=$(git -C "$checkout" symbolic-ref --quiet --short HEAD 2>/dev/null) ||
        branch="detached:${checkout##*/}@$(git -C "$checkout" rev-parse --short HEAD)"
      label="$(disp "$root") [$branch]"
      ;;
    "$root"/*) ;;
    *)
      branch=$(git -C "$checkout" symbolic-ref --quiet --short HEAD 2>/dev/null) ||
        branch="detached:${checkout##*/}@$(git -C "$checkout" rev-parse --short HEAD)"
      label="$(disp "$root") [$branch]"
      ;;
  esac
  capture_path disp "$checkout"; repos+=("$captured_path")
  repo_labels+=("$label")
  repo_roots+=("$root")
}

for r in "${repo_units[@]+"${repo_units[@]}"}"; do
  capture_dir c "$r" || continue
  case "$(repo_type "$c")" in
    standard)
      if [ "$all_worktrees" = true ]; then
        while IFS= read -r -d '' wt; do
          [ -z "$wt" ] && continue
          capture_path canon_dir "$wt" || exit 1
          add_checkout "$c" "$captured_path"
        done < <(active_worktree_paths "$c")
      else
        add_checkout "$c" "$c"
      fi
      ;;
    nested)
      if [ "$all_worktrees" = true ]; then
        while IFS= read -r -d '' wt; do
          [ -z "$wt" ] && continue
          capture_path canon_dir "$wt" || exit 1
          add_checkout "$c" "$captured_path"
        done < <(active_worktree_paths "$c")
      else
        capture_path canon_dir "$c/main" || exit 1
        add_checkout "$c" "$captured_path"
      fi
      ;;
    bare) add_checkout "$c" "$c" ;;
  esac
done

if [ "$owned_command" = structure ]; then
  if [ "$show_help" = true ]; then structure_command "${@:2}" --help; else structure_command "${@:2}"; fi
  exit $?
fi

# Worktree management is a first-class mgit command rather than a generic
# `git worktree` fan-out. It applies each operation according to the standard
# or nested structure of every repository in the current multi-repository set.
if [ "$owned_command" = worktree ]; then
  if [ "$show_help" = true ]; then worktree_command "${@:2}" --help; else worktree_command "${@:2}"; fi
  exit $?
fi

if [ "$owned_command" = sync ]; then
  shift
  [ "$runner_verbose" = false ] || set -- --verbose "$@"
  if [ "$show_help" = true ]; then sync_command "$@" --help; else sync_command "$@"; fi
  exit $?
fi

if [ "$owned_command" = overview ]; then
  shift
  [ "$runner_verbose" = false ] || set -- --verbose "$@"
  [ "$runner_json" = false ] || set -- --json "$@"
  if [ "$show_help" = true ]; then overview_command "$@" --help; else overview_command "$@"; fi
  exit $?
fi

if [ "$owned_command" = chain ]; then
  if [ "$runner_verbose" = true ]; then chain_streaming; else chain_captured; fi
  exit $?
fi

if [ $# -eq 0 ]; then
  for r in "${repo_labels[@]+"${repo_labels[@]}"}"; do
    printf '%s\n' "$r"
  done
  exit 0
fi

[ "$show_help" = false ] || { usage; exit 0; }

printed_cmd=$(printf '%q ' "$@")
printed_cmd="${printed_cmd% }"

runner_raw="$bare"
runner_command=("$@")
runner_template=false
if [ "$runner_raw" = false ] && [ "$runner_verbose" = false ]; then
  resolve_git_aliases "$@"
  template=$(template_file "${resolved_command[@]}")
  if [ -f "$template" ]; then
    template_read "$template"
    runner_template=true
  fi
fi
if [ "$learn_mode" = true ] && [ ${#repos[@]} -eq 0 ]; then
  printf 'mgit: not learned: no repository selected\n' >&2
  exit 1
fi
if [ "$runner_verbose" = true ]; then
  dispatch_streaming
else
  dispatch_captured
fi
